#!/bin/sh
# live-build auto/config
# Generates the live-build configuration for Modernised THL.
set -e

# Keep the selected architecture in one place.  The CI and local wrappers pass
# --architectures explicitly; when invoked directly, use the host architecture.
ARCHITECTURES="$(dpkg --print-architecture)"
ARCH_FROM_ARGS="$(printf '%s\n' "$@" | awk '
    $0 == "--architectures" { getline; print; exit }
    /^--architectures=/ { sub(/^--architectures=/, ""); print; exit }
')"
[ -n "$ARCH_FROM_ARGS" ] && ARCHITECTURES="$ARCH_FROM_ARGS"

case "$ARCHITECTURES" in
  amd64|arm64) ;;
  *) echo "Unsupported build architecture: $ARCHITECTURES" >&2; exit 2 ;;
esac

# amd64 images must also boot on legacy-BIOS machines (e.g. ThinkPad T510), so
# ship GRUB for both BIOS (grub-pc) and UEFI.  arm64 has no BIOS firmware.
case "$ARCHITECTURES" in
  amd64) BOOTLOADERS="grub-pc,grub-efi" ;;
  *)     BOOTLOADERS="grub-efi" ;;
esac

lb config noauto \
  --distribution trixie \
  --distribution-chroot trixie \
  --distribution-binary trixie \
  --initsystem sysvinit \
  --architectures "$ARCHITECTURES" \
  --binary-images iso-hybrid \
  --bootloaders "$BOOTLOADERS" \
  --debian-installer none \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-chroot "http://deb.debian.org/debian/" \
  --mirror-chroot-security "http://security.debian.org/debian-security/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --mirror-binary-security "http://security.debian.org/debian-security/" \
  --apt-recommends false \
  --apt-options "--yes --allow-remove-essential" \
  --apt-indices false \
  --compression xz \
  --chroot-squashfs-compression-type xz \
  --checksums sha512 \
  --iso-application "Bastille" \
  --iso-publisher "Bastille Project" \
  --iso-volume "BASTILLE" \
  --bootappend-live "boot=live components quiet splash username=user net.ifnames=0 biosdevname=0 persistence persistence-encryption=luks" \
  --debootstrap-options "--exclude=systemd-sysv" \
  "${@}"
