#!/bin/sh
# Configure PAM to use pam_thl_duress for login and screen unlock.
#
# Stack order for login (greetd / su / sudo):
#   1. pam_thl_duress  — checks for normal/duress PIN, fires action
#   2. pam_unix        — standard Unix auth (for non-THL users / fallback)
#
# The "sufficient" on pam_thl_duress means: if it succeeds (which it
# does for BOTH normal and duress PINs), skip the rest of the auth stack.
# pam_unix is kept as a fallback for the root account and service users.
set -e

# greetd uses pam service "greetd"
cat > /etc/pam.d/greetd << 'EOF'
auth    sufficient  pam_thl_duress.so
auth    required    pam_unix.so nullok
auth    required    pam_nologin.so

account required    pam_unix.so
account required    pam_nologin.so

session required    pam_unix.so
session optional    pam_elogind.so
EOF

# swaylock uses pam service "swaylock"
cat > /etc/pam.d/swaylock << 'EOF'
auth    sufficient  pam_thl_duress.so
auth    required    pam_unix.so nullok

account required    pam_unix.so

session required    pam_unix.so
EOF

# NOTE: pam_thl_duress is deliberately NOT added to common-auth. That file feeds every
# service (polkit prompts, sshd, su, ...): a duress PIN typed into the wrong prompt must
# never fire a wipe, and polkit dialogs would show an extra "PIN:" prompt. It is only
# in the sign-in (greetd) and lock-screen (swaylock) stacks above.

echo "PAM duress config installed."
