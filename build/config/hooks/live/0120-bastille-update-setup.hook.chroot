#!/bin/bash
# 0120-bastille-update-setup.hook.chroot
# Wire up bastille-update: permissions, polkit, and service enablement.
set -euo pipefail

# ── Permissions ───────────────────────────────────────────────────────────────
chmod 700 /usr/local/sbin/bastille-update
chmod 700 /usr/local/sbin/bastille-recovery
chmod 644 /etc/bastille/update.conf
chmod 644 /usr/share/polkit-1/rules.d/50-bastille-update.rules

# Create download cache dir with tight permissions
mkdir -p /var/cache/bastille-update
chmod 700 /var/cache/bastille-update
mkdir -p /var/lib/bastille/recovery
chmod 700 /var/lib/bastille/recovery

# ── Service enablement ────────────────────────────────────────────────────────
# Bastille is OpenRC/sysvinit. Keep one service contract so an installed image
# cannot silently depend on a systemd unit that is not its PID 1.
chmod +x /etc/init.d/bastille-update-check
rc-update add bastille-update-check default || true

echo "bastille-update: setup complete"
