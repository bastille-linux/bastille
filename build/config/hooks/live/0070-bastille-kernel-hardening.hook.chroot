#!/bin/sh
# Apply kernel hardening configuration inside the chroot.
set -e

# USBGuard is enabled via OpenRC in hook 0010 (rc-update add usbguard).
# Do NOT call systemctl here — we use OpenRC, not systemd.

# USBGuard policy.
#   - Devices already present at boot are allowed. This matters: on a live USB the
#     boot medium itself is a USB device, and deauthorizing it would pull the root
#     filesystem out from under the running system. Keyboards and mice in a VM are
#     present at boot too.
#   - Devices inserted afterwards go through the rules below: input devices and
#     hubs are allowed, everything else (mass storage, ...) is blocked until
#     bastille-usb-inspector / `usbguard allow-device <id>` lets it in.
cat > /etc/usbguard/usbguard-daemon.conf << 'EOF'
RuleFile=/etc/usbguard/rules.conf
ImplicitPolicyTarget=block
PresentDevicePolicy=allow
PresentControllerPolicy=keep
InsertedDevicePolicy=apply-policy
RestoreControllerDeviceState=false
DeviceManagerBackend=uevent
IPCAllowedUsers=root
IPCAllowedGroups=usbguard
DeviceRulesWithPort=false
AuditBackend=LinuxAudit
EOF

cat > /etc/usbguard/rules.conf << 'EOF'
# Input devices: every interface is HID (keyboards, mice, tablets, composites).
allow with-interface all-of { 03:*:* }
# Hubs
allow with-interface all-of { 09:*:* }
# Block everything else by default
block
EOF

# Update GRUB to add hardening cmdline parameters
if [ -f /etc/default/grub ]; then
    update-grub || true
fi

# Make bastille-hardening.cfg auto-included in grub config
mkdir -p /etc/default/grub.d

# Restrict /proc to owning user (hidepid)
# We patch /etc/fstab to mount proc with hidepid=2
if ! grep -q hidepid /etc/fstab 2>/dev/null; then
    sed -i 's|proc /proc proc defaults|proc /proc proc defaults,hidepid=2,gid=proc|' /etc/fstab || true
    echo "proc /proc proc defaults,hidepid=2,gid=proc 0 0" >> /etc/fstab
fi

# Add user to proc group so it can still read its own /proc entries
grep -q '^proc:' /etc/group || groupadd -r proc
usermod -aG proc user || true
# /proc is mounted hidepid=2,gid=proc: polkitd (its own user) must be in that group
# or it cannot read /proc/<pid>/{stat,status} of the process asking for authorization
# and rejects every pkexec / polkit-agent request.
for u in polkitd; do
    getent passwd "$u" >/dev/null && usermod -aG proc "$u"
done

# Disable core dumps via limits.conf
cat >> /etc/security/limits.conf << 'EOF'
* hard core 0
* soft core 0
EOF

# Disable coredumps via PAM (OpenRC does not use systemd coredump handling)
# limits.conf already has hard core 0 from the block above.
# Also disable via sysctl (backed by 99-bastille-hardening.conf):
#   fs.suid_dumpable = 0

# Screen lock eviction: handled by swayidle in the Sway config.
# swayidle calls swaylock and, on unlock, runs bastille-keyguard evict.
# (injected into Sway config by hook 0030)

echo "Kernel hardening and USBGuard configured."
