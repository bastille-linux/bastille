#!/bin/bash
# Hook: Set permissions on all Bastille apps and helpers
set -euo pipefail

# ── seatd: pre-populate /etc/group so Sway can get seat access ────────────────
# 'user' is created at runtime by live-boot, so usermod fails at build time.
# Instead, add 'user' directly to the group file now; live-boot preserves it.
python3 - << 'PYEOF'
import sys
# 'proc' is the hidepid exemption group: without it libsystemd cannot read /proc/1/cgroup,
# so polkit and every logind client fail with "No session for pid".
groups_to_join = ['seat', 'video', 'input', 'audio', 'render', 'tty', 'proc']
live_user = 'user'
with open('/etc/group', 'r') as f:
    lines = f.readlines()
new_lines = []
for line in lines:
    parts = line.rstrip('\n').split(':')
    if len(parts) == 4 and parts[0] in groups_to_join:
        members = [m for m in parts[3].split(',') if m]
        if live_user not in members:
            members.append(live_user)
        parts[3] = ','.join(members)
        new_lines.append(':'.join(parts) + '\n')
    else:
        new_lines.append(line)
with open('/etc/group', 'w') as f:
    f.writelines(new_lines)
print("seat/video/input/audio/render/tty groups: user added")
PYEOF

# ── User-facing apps (executable by user) ─────────────────────────────────────
for bin in \
    /usr/local/bin/bastille-settings \
    /usr/local/bin/bastille-store \
    /usr/local/bin/bastille-files \
    /usr/local/bin/bastille-shell \
    /usr/local/bin/bastille-setup \
    /usr/local/bin/bastille-launcher \
    /usr/local/bin/bastille-powermenu \
    /usr/local/bin/bastille-notes \
    /usr/local/bin/bastille-calendar \
    /usr/local/bin/bastille-weather \
    /usr/local/bin/bastille-maps \
    /usr/local/bin/bastille-update \
    /usr/local/bin/bastille-install \
    /usr/local/bin/bastille-subsystem; do
    [ -f "$bin" ] && chmod 755 "$bin"
done

# ── Polkit-gated root helpers (root:root, 700 — only pkexec can run these) ────
for sbin in \
    /usr/local/sbin/bastille-set-pins \
    /usr/local/sbin/bastille-set-service \
    /usr/local/sbin/bastille-set-nft \
    /usr/local/sbin/bastille-set-wg \
    /usr/local/sbin/bastille-set-dns \
    /usr/local/sbin/bastille-update \
    /usr/local/sbin/bastille-apps \
    /usr/local/sbin/bastille-subsystem-root; do
    [ -f "$sbin" ] && chmod 700 "$sbin" && chown root:root "$sbin"
done

# ── Bastille config dir ────────────────────────────────────────────────────────
install -d -m 755 /etc/bastille
chown root:root /etc/bastille

# Create default version file if missing
if [ ! -f /etc/bastille/version ]; then
    echo "dev-$(date +%Y%m%d)" > /etc/bastille/version
fi
chmod 644 /etc/bastille/version /etc/bastille/update.conf 2>/dev/null || true

# ── Sway / Waybar / swaylock — fix home dir ownership ─────────────────────────
# These configs are laid in as root; chown to 'user' at runtime via login hook
# (done in /etc/profile.d/bastille-home-perms.sh)

# ── Polkit rules ──────────────────────────────────────────────────────────────
chmod 644 /usr/share/polkit-1/rules.d/50-bastille-helpers.rules 2>/dev/null || true

# ── Desktop database ──────────────────────────────────────────────────────────
update-desktop-database /usr/share/applications 2>/dev/null || true

# ── greetd — auto-login live user directly into Sway ─────────────────────────
# Auto-login is correct for a live system: no password prompt, and greetd
# creates the seat session itself so Sway inherits it cleanly via seatd.
cat > /etc/greetd/config.toml << 'TOML'
[terminal]
# Gettys from inittab own tty1-6, so greetd takes VT7.
vt = 7

[default_session]
command = "/usr/local/bin/bastille-session"
user = "user"
service = "bastille-session"
TOML
chmod 755 /usr/local/bin/bastille-session /etc/init.d/greetd \
    /usr/local/sbin/bastille-install-backend

echo "bastille-apps-setup: done"
