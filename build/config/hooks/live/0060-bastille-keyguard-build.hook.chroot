#!/bin/sh
# Build bastille-keyguard and gpggrid inside the chroot.
set -e

# bastille-keyguard
cd /usr/local/src/bastille-keyguard
make && make install DESTDIR=
make clean

# gpggrid
cd /usr/local/src/gpggrid
make && make install DESTDIR=
make clean

# bastille-profile
install -m 0755 /usr/local/src/bastille-profile/bastille-profile /usr/local/bin/bastille-profile

# bastille-usb-authorize (already in includes.chroot)
chmod 0755 /usr/local/sbin/bastille-usb-authorize

# Create profile storage dir
mkdir -p /var/lib/thl/profiles
chmod 700 /var/lib/thl/profiles
mkdir -p /run/thl  # created fresh each boot by tmpfiles.d

# No systemd-tmpfiles on this system: recreate the runtime dirs at every boot from
# the OpenRC "local" service (enabled in hook 0090), which runs /etc/local.d/*.start.
install -d -m 755 /etc/local.d
cat > /etc/local.d/bastille-run-dirs.start << 'LOCALEOF'
#!/bin/sh
install -d -m 0700 /run/thl /run/thl/profiles
LOCALEOF
chmod 755 /etc/local.d/bastille-run-dirs.start

echo "bastille-keyguard, gpggrid, bastille-profile installed."
