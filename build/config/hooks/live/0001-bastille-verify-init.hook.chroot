#!/bin/sh
# Fail the build early if the image would boot with systemd as PID 1.
#
# The init system is chosen by the package lists, not by this hook:
#   - debootstrap runs with --exclude=systemd-sysv (auto/config)
#   - bastille-base.list.chroot installs sysvinit-core + openrc
#   - live.list.chroot installs live-config-sysvinit (live user, hostname, ssh keys)
# On Debian 13 openrc depends on insserv, which conflicts with systemd-sysv, so
# the old "install openrc, then swap init" order cannot work and systemd-sysv
# must never be requested by anything.
#
# History: on Debian 12 an earlier version of this hook purged systemd-sysv and ran
# `apt-get -f install`, which silently reinstalled it. Every image booted systemd
# and no OpenRC service ever started. This check exists so that cannot recur.
set -e

fail() { echo "[0001] FATAL: $*" >&2; exit 1; }

installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed'; }

installed systemd-sysv && fail "systemd-sysv is installed"
installed sysvinit-core || fail "sysvinit-core is not installed"
installed openrc || fail "openrc is not installed"
installed live-config-sysvinit || fail "live-config-sysvinit is not installed"
installed live-config-systemd && fail "live-config-systemd is installed (it cannot run under sysvinit)"
installed user-setup || fail "user-setup is not installed (live-config cannot create the live user)"

init_target="$(readlink -f /sbin/init)"
case "$init_target" in *systemd*) fail "/sbin/init -> $init_target" ;; esac
[ -f /etc/inittab ] || fail "no /etc/inittab"
[ -x /sbin/openrc ] || fail "no /sbin/openrc"

echo "[0001] init OK: /sbin/init -> $init_target, openrc + live-config-sysvinit present"
