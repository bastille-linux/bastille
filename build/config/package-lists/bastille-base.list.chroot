# Base system
# Init: debootstrap runs with --exclude=systemd-sysv, so sysvinit-core + openrc
# are installed here. On trixie openrc depends on insserv, which conflicts with
# systemd-sysv, so systemd-sysv must never be requested.
sysvinit-core
sysvinit-utils
initscripts
openrc
# debootstrap installs `init` + systemd-sysv even with --exclude, and apt's solver
# will not swap an already-installed init on its own. A trailing '-' is apt syntax
# for "remove": it is passed through unchanged by live-build (xargs apt-get install).
systemd-sysv-
openssh-server
dbus
udev
util-linux
locales
tzdata
ca-certificates
curl
wget

# seatd — seat management for Sway
seatd
libseat1

# elogind: the logind provider for a sysvinit system. On trixie libpam-systemd
# hard-depends on systemd-sysv (which conflicts with sysvinit-core), and polkitd's
# default logind is libpam-systemd, so name elogind explicitly. It also creates
# XDG_RUNTIME_DIR for logins.
elogind
libpam-elogind

# Sway Wayland compositor stack
sway
swayidle
swaylock
foot
grim
slurp
wl-clipboard
xdg-desktop-portal-wlr
kanshi
brightnessctl

# Greeter: greetd + our own GTK greeter (bastille-greeter) run inside cage
greetd
cage

# GPU drivers
intel-microcode
firmware-amd-graphics
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-mediatek
firmware-intel-sound
firmware-sof-signed
firmware-misc-nonfree
mesa-vulkan-drivers
libgl1-mesa-dri
xwayland

# Network & VPN
wireguard-tools
network-manager
iproute2
nftables

# PGP
gnupg2
gpg-agent
pinentry-curses

# Build tools (hooks compile C helpers)
gcc
make
libpam0g-dev
libsodium-dev
libkeyutils-dev
libncurses-dev
dpkg-dev

# USBGuard
usbguard

# Security
apparmor
apparmor-utils
apparmor-profiles
apparmor-profiles-extra
libpam-runtime
libpam-modules

# File system & encryption
cryptsetup
cryptsetup-initramfs
lvm2
e2fsprogs
dosfstools

# Browser
firefox-esr

# Onion routing (disabled by default)
tor

# Flatpak
flatpak

# Bluetooth tooling for the shell's Bluetooth panel. The service stays off and the radio rfkill-blocked
# at boot (bastille-bluetooth-block); the user switches it on explicitly.
bluez
libspa-0.2-bluetooth
xdg-desktop-portal

# Utilities
bash
zsh
nano
vim
less
file
htop
lsof
rfkill
nvme-cli
hdparm
dmidecode
flashrom
xprintidle
python3
python3-gi
python3-gi-cairo
python3-argon2
libsodium23

# Privacy & anti-forensics
secure-delete
mat2

# Update / polkit
polkitd
pkexec
parted
jq
fwupd

# Laptop, audio, printing, and scanning support. Bluetooth and webcam access
# remain explicit user choices through the security settings and rfkill policy.
power-profiles-daemon
upower
acpi
acpid
v4l-utils
pavucontrol
cups
cups-client
system-config-printer
sane-airscan
ipp-usb
printer-driver-all

# Fonts & theming
fonts-dejavu-core
fonts-liberation
adwaita-icon-theme
librsvg2-common
fonts-noto-core
fonts-inter
fonts-font-awesome

# GTK4/libadwaita — runtime libs needed by wizard + settings (shipped in ISO)
# Heavy app-specific deps (WebKitGTK, GStreamer, VTE) are pulled by the
# wizard at first boot when the user selects those apps.
gir1.2-adw-1
gir1.2-gtk-4.0
gir1.2-vte-3.91
libadwaita-1-0

# UI extras
lxpolkit

# argon2 CLI — PIN key derivation for subsystems
argon2
# age encryption and dnscrypt-proxy are in trixie main
age
dnscrypt-proxy

# Disk installer dependencies (arch-specific GRUB package handled by the early hook)
squashfs-tools
efibootmgr

# Notification support
libnotify-bin

# system info
fastfetch

# cron (periodic RAM scrub)
cron

# Installer: common GRUB support. The architecture-specific EFI module is
# installed by 0005-bastille-architecture-packages.hook.chroot so amd64 and
# arm64 builds never ask apt to resolve the other architecture's package.
grub-common
grub2-common

# Bastille shell (menu bar, dock, launcher, notification/control centre)
gir1.2-gtk4layershell-1.0
libgtk4-layer-shell0
python3-gi-cairo
cliphist
wireplumber
pipewire
pipewire-pulse
brightnessctl
swaybg

# Bastille Browser (WebKitGTK, with its sandbox helpers) and basic media codecs
gir1.2-webkit-6.0
bubblewrap
xdg-dbus-proxy
gstreamer1.0-plugins-good
