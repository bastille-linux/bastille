# Base system
# Init: debootstrap runs with --exclude=systemd-sysv, so sysvinit-core + openrc
# are installed here. On trixie openrc depends on insserv, which conflicts with
# systemd-sysv, so systemd-sysv must never be requested.
sysvinit-core
sysvinit-utils
initscripts
openrc
openssh-server
dbus
udev
util-linux
locales
tzdata
ca-certificates
curl
wget

# seatd — seat management for Sway, no logind/elogind dependency needed
seatd
libseat1

# Sway Wayland compositor stack
sway
swayidle
swaylock
foot
waybar
grim
slurp
wl-clipboard
xdg-desktop-portal-wlr
kanshi
brightnessctl
mako-notifier

# Greeter (agreety text greeter is bundled with greetd)
greetd

# GPU drivers
firmware-amd-graphics
firmware-misc-nonfree
mesa-vulkan-drivers
libgl1-mesa-dri

# Network & VPN
wireguard-tools
network-manager
iproute2
nftables

# PGP
gnupg2
gpg-agent
pinentry-curses

# Build tools (hooks compile C helpers)
gcc
make
libpam0g-dev
libsodium-dev
libkeyutils-dev
libncurses-dev
dpkg-dev

# USBGuard
usbguard

# Security
apparmor
apparmor-utils
apparmor-profiles
apparmor-profiles-extra
libpam-runtime
libpam-modules

# File system & encryption
cryptsetup
cryptsetup-initramfs
lvm2
e2fsprogs
dosfstools

# Browser
firefox-esr

# Onion routing (disabled by default)
tor

# Flatpak
flatpak
xdg-desktop-portal

# Utilities
bash
zsh
nano
vim
less
file
htop
lsof
rfkill
python3
python3-gi
python3-gi-cairo
python3-argon2
libsodium23

# Privacy & anti-forensics
secure-delete
mat2

# Update / polkit
polkitd
pkexec
parted
jq

# Fonts & theming
fonts-dejavu-core
fonts-liberation
adwaita-icon-theme
fonts-noto-core

# GTK4/libadwaita — runtime libs needed by wizard + settings (shipped in ISO)
# Heavy app-specific deps (WebKitGTK, GStreamer, VTE) are pulled by the
# wizard at first boot when the user selects those apps.
gir1.2-adw-1
gir1.2-gtk-4.0
libadwaita-1-0

# UI extras
lxpolkit

# argon2 CLI — PIN key derivation for subsystems
argon2
# age encryption, tuigreet greeter and dnscrypt-proxy are all in trixie main
age
tuigreet
dnscrypt-proxy

# Disk installer dependencies (arch-specific grub packages handled by CI workflow strip step)
squashfs-tools
efibootmgr

# Notification support
libnotify-bin

# system info
fastfetch

# cron (periodic RAM scrub)
cron

# Installer: GRUB EFI modules for the running architecture. Only the -bin
# package is installed: its postinst does not try to touch this image's disk.
grub-common
grub2-common
#if ARCHITECTURES amd64
grub-efi-amd64-bin
#endif
#if ARCHITECTURES arm64
grub-efi-arm64-bin
#endif
