// Bastille OS — polkit rules for all privileged helpers
// All helpers are owned root:root, mode 700.
// Any interactive local user on the seat may run them via pkexec (the live
// account is 'user'; an installed system has the account chosen in the installer).

const BASTILLE_HELPERS = [
    "/usr/local/sbin/bastille-set-pins",
    "/usr/local/sbin/bastille-set-service",
    "/usr/local/sbin/bastille-set-nft",
    "/usr/local/sbin/bastille-set-wg",
    "/usr/local/sbin/bastille-set-dns",
    "/usr/local/sbin/bastille-update",
    "/usr/local/sbin/bastille-apps",
    "/usr/local/sbin/bastille-install-backend",
    "/sbin/reboot",
    "/sbin/poweroff",
    "/usr/local/src/bastille-persist/bastille-persist-setup",
];

// The live session has no usable password for 'user', so the installer (and
// reboot/poweroff after it) must not ask for one there. Detected by the live
// medium being mounted; on an installed system the normal AUTH_SELF applies.
// Every helper is root-equivalent for the live user anyway, so none prompts there.
const LIVE_NOPROMPT = BASTILLE_HELPERS;

function isLive() {
    try {
        polkit.spawn(["/usr/bin/test", "-d", "/run/live/medium"]);
        return true;
    } catch (e) {
        return false;
    }
}

polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.policykit.exec") return;
    var prog = action.lookup("program");
    if (prog && LIVE_NOPROMPT.indexOf(prog) >= 0 &&
        subject.local === true && subject.active === true && isLive()) {
        return polkit.Result.YES;
    }
});

polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.policykit.exec") return;
    var prog = action.lookup("program");
    if (!prog) return;
    for (var i = 0; i < BASTILLE_HELPERS.length; i++) {
        if (prog === BASTILLE_HELPERS[i]) {
            if (subject.user !== "root" &&
                subject.local === true &&
                subject.active === true) {
                return polkit.Result.AUTH_SELF;
            }
        }
    }
});
