#!/bin/bash
# thl-network-guard — enforce offline mode when network security can't be guaranteed
#
# Runs under OpenRC. Periodically checks that:
#   1. VPN (wg0) is up and has recent traffic
#   2. DNS is going through the stub resolver
#   3. No captive portal or DNS hijacking is active
#   4. No unexpected outbound connections exist
#
# On failure: blocks all network traffic (offline mode) and notifies user.
# User can re-enable manually after verifying the connection.

set -euo pipefail

OFFLINE_FLAG="/run/thl/network-offline"
CHECK_INTERVAL=30
DNS_CHECK_HOST="dns.quad9.net"
VPN_INTERFACE="wg0"
DNS_LISTENER="127.0.0.1"

log()  { logger -t thl-network-guard "$*"; }
notify() {
    # Send a Wayland desktop notification via notify-send if a session is active
    local user_session; user_session="$(who | awk 'NF {print $1; exit}')"
    if [ -n "$user_session" ]; then
        local uid; uid="$(id -u "$user_session" 2>/dev/null || true)"
        [ -n "$uid" ] || return 0
        su -s /bin/sh "$user_session" -c \
            "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${uid}/bus \
             notify-send -u critical -t 0 'THL Network Guard' '$*'" 2>/dev/null || true
    fi
}

go_offline() {
    local reason="$1"
    if [ ! -f "$OFFLINE_FLAG" ]; then
        log "OFFLINE MODE: $reason"
        touch "$OFFLINE_FLAG"
        # Block all outbound except lo using nftables emergency table
        nft -f /etc/nftables/thl-offline.nft 2>/dev/null || true
        notify "Network blocked: $reason. Run 'thl-network-guard --restore' to reconnect."
    fi
}

go_online() {
    if [ -f "$OFFLINE_FLAG" ]; then
        log "Restoring network — VPN and DNS checks passed"
        rm -f "$OFFLINE_FLAG"
        nft delete table inet thl-offline 2>/dev/null || true
    fi
}

check_vpn() {
    # wg0 interface must exist
    ip link show "$VPN_INTERFACE" &>/dev/null || return 1

    # wg0 must have received bytes in the last 120 seconds
    # (WireGuard keepalive is 25s, so 120s means at least 4 missed keepalives)
    local last_handshake
    last_handshake="$(wg show "$VPN_INTERFACE" latest-handshakes 2>/dev/null | awk '{print $2}' | head -1)"
    if [ -z "$last_handshake" ] || [ "$last_handshake" = "0" ]; then
        return 1
    fi
    local now; now="$(date +%s)"
    local age=$(( now - last_handshake ))
    [ "$age" -lt 180 ] || return 1
}

check_dns() {
    # DNS must resolve through dnscrypt-proxy's local listener. Use the libc
    # resolver so this works without a distro-specific resolver CLI.
    getent ahostsv4 "$DNS_CHECK_HOST" >/dev/null 2>&1 || return 1

    # Check that /etc/resolv.conf still points to stub
    grep -Eq "^[[:space:]]*nameserver[[:space:]]+${DNS_LISTENER//./\\.}([[:space:]]|$)" /etc/resolv.conf || return 1
}

check_captive_portal() {
    # NetworkManager's connectivity state is the OpenRC-compatible way to
    # distinguish a portal from a normal link. A captive portal cannot be
    # safely bypassed while the kill switch is active.
    command -v nmcli >/dev/null 2>&1 || return 0
    local state; state="$(nmcli -t -f CONNECTIVITY general 2>/dev/null || true)"
    case "$state" in
        portal|none) return 1 ;;
        *) return 0 ;;
    esac
}

# ── Command dispatch ───────────────────────────────────────────────────────

case "${1:-watch}" in
    --restore)
        rm -f "$OFFLINE_FLAG"
        nft delete table inet thl-offline 2>/dev/null || true
        log "Network manually restored"
        echo "Network restored."
        exit 0
        ;;
    --status)
        if [ -f "$OFFLINE_FLAG" ]; then
            echo "OFFLINE MODE ACTIVE — network is blocked"
            exit 1
        else
            echo "Network OK"
            exit 0
        fi
        ;;
    watch)
        ;;
    *)
        echo "Usage: thl-network-guard [--restore|--status|watch]" >&2
        exit 1
        ;;
esac

# ── Watch loop ─────────────────────────────────────────────────────────────

log "network guard started (interval=${CHECK_INTERVAL}s)"

while true; do
    FAIL_REASON=""

    if ! check_vpn; then
        FAIL_REASON="VPN tunnel down or stale (wg0 no recent handshake)"
    elif ! check_dns; then
        FAIL_REASON="DNS not routing through stub resolver"
    elif ! check_captive_portal; then
        FAIL_REASON="DNS hijacking or captive portal detected"
    fi

    if [ -n "$FAIL_REASON" ]; then
        go_offline "$FAIL_REASON"
    else
        go_online
    fi

    sleep "$CHECK_INTERVAL"
done
