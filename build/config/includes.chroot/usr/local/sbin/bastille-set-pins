#!/usr/bin/env python3
"""bastille-set-pins — PIN manager (duress, fake-duress, DSM).

The PINs are stored as libsodium Argon2id hashes in /etc/bastille/pins.conf and
the files the consumers actually read are regenerated from them:

  duress, fake-duress -> /etc/bastille/duress.conf   read by pam_thl_duress
  dsm                 -> /etc/bastille/dsm.pin       read by bastille-dsm-prompt
                         /etc/bastille/dsm.enabled   flag for the DSM watchdog

Hashing goes through libsodium itself (ctypes) so what is written here is exactly
what crypto_pwhash_str_verify() in the PAM module / DSM prompt will accept.

    bastille-set-pins --type duress --pin-stdin
    bastille-set-pins --type dsm --clear
"""

import argparse
import ctypes
import ctypes.util
import json
import os
import sys

PINS_FILE = "/etc/bastille/pins.conf"
DURESS_CONF = "/etc/bastille/duress.conf"
DSM_PIN = "/etc/bastille/dsm.pin"
DSM_FLAG = "/etc/bastille/dsm.enabled"
PINS_DIR = "/etc/bastille"
ACTIONS = "/etc/bastille/actions"

# PIN type -> action line fields for pam_thl_duress ("<type> <hash> <action> [arg]")
DURESS_ACTIONS = {
    "duress": f"wipe {ACTIONS}/duress-wipe.sh",        # wipe keys, VPN off, power off
    "fake-duress": f"wipe {ACTIONS}/fake-wipe.sh",     # look wiped, land in the decoy profile
}

OPSLIMIT_MODERATE = 3
MEMLIMIT_MODERATE = 268435456


def die(msg):
    print(f"bastille-set-pins: {msg}", file=sys.stderr)
    sys.exit(1)


def _sodium():
    path = ctypes.util.find_library("sodium") or "libsodium.so.23"
    lib = ctypes.CDLL(path)
    if lib.sodium_init() < 0:
        die("libsodium failed to initialise")
    lib.crypto_pwhash_str.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_ulonglong,
                                      ctypes.c_ulonglong, ctypes.c_size_t]
    lib.crypto_pwhash_str.restype = ctypes.c_int
    return lib


def pwhash(pin):
    lib = _sodium()
    out = ctypes.create_string_buffer(128)
    pw = pin.encode()
    if lib.crypto_pwhash_str(out, pw, len(pw), OPSLIMIT_MODERATE, MEMLIMIT_MODERATE) != 0:
        die("could not hash the PIN (out of memory?)")
    return out.value.decode()


def load_pins():
    try:
        with open(PINS_FILE) as f:
            return json.load(f)
    except Exception:
        return {}


def write_private(path, text):
    os.makedirs(PINS_DIR, exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def regenerate(pins):
    """Rewrite every file derived from pins.conf."""
    write_private(PINS_FILE, json.dumps(pins, indent=2))

    lines = ["# Generated by bastille-set-pins — do not edit.",
             "# <type> <argon2id hash> <action> [arg]"]
    n = 0
    for t, action in DURESS_ACTIONS.items():
        if t in pins:
            lines.append(f"duress {pins[t]} {action}")
            n += 1
    if n:
        write_private(DURESS_CONF, "\n".join(lines) + "\n")
    else:
        try:
            os.unlink(DURESS_CONF)      # nothing configured: the PAM module ignores it
        except FileNotFoundError:
            pass

    if "dsm" in pins:
        write_private(DSM_PIN, pins["dsm"] + "\n")
        write_private(DSM_FLAG, "")
    else:
        for p in (DSM_PIN, DSM_FLAG):
            try:
                os.unlink(p)
            except FileNotFoundError:
                pass


def main():
    if os.geteuid() != 0:
        die("must run as root (use pkexec)")

    parser = argparse.ArgumentParser()
    parser.add_argument("--type", required=True, choices=["login", "duress", "fake-duress", "dsm"],
                        dest="pin_type")
    parser.add_argument("--pin", default=None)
    parser.add_argument("--pin-stdin", action="store_true",
                        help="read the PIN from stdin (keeps it out of argv)")
    parser.add_argument("--clear", action="store_true")
    args = parser.parse_args()

    if args.pin_stdin:
        args.pin = sys.stdin.readline().rstrip("\n")
    if not args.clear:
        if args.pin is None:
            die("--pin or --pin-stdin required")
        if len(args.pin) < 4 or not args.pin.isdigit():
            die("PIN must be 4+ digits")

    pins = load_pins()
    if args.clear:
        pins.pop(args.pin_type, None)
    else:
        pins[args.pin_type] = pwhash(args.pin)
    regenerate(pins)
    print(f"PIN type '{args.pin_type}' {'cleared' if args.clear else 'set'} successfully.")


if __name__ == "__main__":
    main()
