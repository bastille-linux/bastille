#!/bin/sh
# bastille-usb-authorize — called by udev when a USB device is plugged in.
# Blocks the device only while the screen is locked.

DEVICE="$1"
SYS_PATH="/sys/bus/usb/devices/$DEVICE"

# Host controllers / root hubs are named usbN: never block those.
case "$DEVICE" in
    usb[0-9]*) exit 0 ;;
esac

if pgrep -x swaylock >/dev/null 2>&1; then
    logger -t bastille-usb "Blocking USB device $DEVICE (screen locked)"
    echo 0 > "$SYS_PATH/authorized" 2>/dev/null || true
else
    logger -t bastille-usb "Allowing USB device $DEVICE (screen unlocked)"
fi
exit 0
