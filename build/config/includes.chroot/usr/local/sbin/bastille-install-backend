#!/usr/bin/env python3
"""bastille-install-backend — root-side installer for Bastille OS.

Installs the running live system to a disk with a LUKS2-encrypted root.
It has no GUI and speaks JSON lines on stdout so bastille-install (the GTK
wizard) or a shell can drive it.

    bastille-install-backend --list-disks
    bastille-install-backend --preflight     # validate JSON config and target only
    bastille-install-backend --install        # JSON config on stdin

Install config (stdin, one JSON object — secrets never touch argv):
    {"disk": "/dev/sda", "confirm": "/dev/sda",
     "passphrase": "...", "username": "alice", "password": "...",
     "fullname": "Alice", "hostname": "bastille",
     # optional:
     "level": "standard"|"high"|"anon", "profiles": ["work"],
     "fake_duress_target": "decoy",
     "accounts": ["guerrilla", "pgp"], "apps": ["browser", "mail"],
     "pins": {"duress": "1234", "fake-duress": "4321", "dsm": "5555"}}

Disk layout (GPT):
    p1  512 MiB  FAT32  EFI system partition
    p2    1 GiB  ext4   /boot       (unencrypted: GRUB cannot unlock argon2id)
    p3    rest   LUKS2  root (ext4) (argon2id)

Events (stdout, one JSON object per line):
    {"event": "step",  "id": ..., "label": ..., "progress": 0..1}
    {"event": "log",   "msg": ...}
    {"event": "done"}
    {"event": "error", "msg": ...}
"""

import json
import os
import platform
import re
import shutil
import subprocess
import sys

LIVE_SQUASHFS = ["/run/live/medium/live/filesystem.squashfs",
                 "/lib/live/mount/medium/live/filesystem.squashfs",
                 "/run/bastille/filesystem.squashfs"]
TARGET = "/mnt/bastille-target"
MAPPER = "cryptroot"   # must match /etc/crypttab so root=/dev/mapper/cryptroot works
ESP_MIB = 512
BOOT_MIB = 1024

GRUB_TARGETS = {"aarch64": "arm64-efi", "x86_64": "x86_64-efi"}
# proc: exempt from /proc hidepid, which libsystemd (polkit, logind clients) needs.
USER_GROUPS = ["proc", "video", "input", "audio", "render", "tty", "seat", "_seatd",
               "plugdev", "netdev", "cdrom", "floppy", "dialout"]

USERNAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,30}$")
HOSTNAME_RE = re.compile(r"^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$")

_STEPS = [
    ("check",      "Checking the disk"),
    ("partition",  "Partitioning"),
    ("format",     "Creating the encrypted volume"),
    ("copy",       "Copying system files"),
    ("configure",  "Configuring the system"),
    ("apps",       "Installing selected apps"),
    ("personalise", "Setting up profiles, accounts and PINs"),
    ("initramfs",  "Building the boot image"),
    ("bootloader", "Installing the bootloader"),
    ("finish",     "Finishing up"),
]
# Rough weight of each step in the overall progress bar.
_WEIGHTS = {"check": 0.02, "partition": 0.04, "format": 0.07, "copy": 0.45,
            "configure": 0.06, "apps": 0.10, "personalise": 0.03,
            "initramfs": 0.12, "bootloader": 0.08, "finish": 0.03}

LEVELS = ("standard", "high", "anon")
PIN_TYPES = ("duress", "fake-duress", "dsm")
ACCOUNT_TYPES = ("email", "guerrilla", "pgp", "signal", "session", "wireguard")
PROFILE_RE = re.compile(r"^[a-zA-Z0-9_-]{1,32}$")

# Optional apps (the Settings app is always kept). Maps to extra Debian
# packages the app needs beyond the GTK4 runtime already in the image.
REQUIRED_APPS = ("settings", "files", "browser", "terminal")   # preinstalled, never removed
APP_DEPS = {
    "settings": [],
    "browser": ["tor"],
    "mail": ["gir1.2-soup-3.0"],
    "messages": [],
    "calendar": [],
    "files": [],
    "notes": [],
    "documents": ["libreoffice-writer"],
    "sheets": ["libreoffice-calc"],
    "presentations": ["libreoffice-impress"],
    "terminal": ["gir1.2-vte-3.91"],
    "maps": ["gir1.2-webkit-6.0"],
    "music": ["gir1.2-gst-1.0", "gstreamer1.0-plugins-good", "python3-mutagen"],
    "weather": ["gir1.2-soup-3.0"],
}

HARDWARE_PROFILES = {
    "thinkpad": {
        "name": "Lenovo / IBM ThinkPad",
        "support": "recommended",
        "notes": "Best-supported laptop family; verify the exact Wi-Fi and fingerprint-reader model.",
    },
    "windows-uefi": {
        "name": "Modern Windows / UEFI laptop",
        "support": "best-effort",
        "notes": "Designed for ordinary Intel/AMD UEFI laptops; check suspend, Wi-Fi, and firmware support.",
    },
    "intel-mac": {
        "name": "Intel MacBook",
        "support": "experimental",
        "notes": "Experimental profile for Intel Macs; T2 Macs and Apple Silicon are not supported yet.",
    },
    "generic": {
        "name": "Other / unknown hardware",
        "support": "best-effort",
        "notes": "Uses conservative generic settings and records the hardware for later diagnosis.",
    },
}


MAIL_PROVIDERS = {
    "gmail.com": ("imap.gmail.com", "smtp.gmail.com"),
    "googlemail.com": ("imap.gmail.com", "smtp.gmail.com"),
    "outlook.com": ("outlook.office365.com", "smtp-mail.outlook.com"),
    "hotmail.com": ("outlook.office365.com", "smtp-mail.outlook.com"),
    "live.com": ("outlook.office365.com", "smtp-mail.outlook.com"),
    "yahoo.com": ("imap.mail.yahoo.com", "smtp.mail.yahoo.com"),
    "icloud.com": ("imap.mail.me.com", "smtp.mail.me.com"),
    "me.com": ("imap.mail.me.com", "smtp.mail.me.com"),
    "fastmail.com": ("imap.fastmail.com", "smtp.fastmail.com"),
    "gmx.com": ("imap.gmx.com", "mail.gmx.com"),
    "gmx.net": ("imap.gmx.net", "mail.gmx.net"),
    "mail.com": ("imap.mail.com", "smtp.mail.com"),
}


def mail_servers(address):
    """IMAP/SMTP host guess from the address: known providers, else imap./smtp.<domain>."""
    domain = address.rsplit("@", 1)[-1].lower()
    return MAIL_PROVIDERS.get(domain, (f"imap.{domain}", f"smtp.{domain}"))


def emit(**ev):
    sys.stdout.write(json.dumps(ev) + "\n")
    sys.stdout.flush()


def log(msg):
    emit(event="log", msg=str(msg))


class InstallError(Exception):
    pass


def run(*args, input=None, check=True, env=None):
    """Run a command, stream its output to the log, raise InstallError on failure."""
    p = subprocess.run(list(args), input=input, text=True, env=env,
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    out = p.stdout.strip()
    if out:
        for line in out.splitlines()[-20:]:
            log(line)
    if check and p.returncode != 0:
        tail = " | ".join(out.splitlines()[-4:]) if out else "no output"
        raise InstallError(f"{args[0]} failed (exit {p.returncode}): {tail}")
    return p


def chroot(*args, **kw):
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive", LC_ALL="C.UTF-8")
    return run("chroot", TARGET, *args, env=env, **kw)


def part_path(disk, n):
    sep = "p" if disk[-1].isdigit() else ""
    return f"{disk}{sep}{n}"


def wait_for_node(path, timeout=10):
    """Block device nodes can lag (or never appear inside containers)."""
    import time
    deadline = time.time() + timeout
    while time.time() < deadline:
        if os.path.exists(path):
            return
        time.sleep(0.2)
    # Fall back to creating the node from sysfs.
    name = os.path.basename(path)
    try:
        major, minor = open(f"/sys/class/block/{name}/dev").read().strip().split(":")
        os.mknod(path, 0o660 | 0o060000, os.makedev(int(major), int(minor)))
    except Exception:
        raise InstallError(f"partition node {path} did not appear")


# ── Disk discovery ────────────────────────────────────────────────────────────

def live_medium_disk():
    """Whole-disk device the live system booted from, if any."""
    try:
        src = subprocess.run(["findmnt", "-n", "-o", "SOURCE", "/run/live/medium"],
                             capture_output=True, text=True).stdout.strip()
        if not src:
            return None
        parent = subprocess.run(["lsblk", "-no", "PKNAME", src],
                                capture_output=True, text=True).stdout.strip()
        return f"/dev/{parent}" if parent else src
    except Exception:
        return None


def secure_boot_enabled():
    """Return whether UEFI Secure Boot is enabled on the live host.

    Bastille currently installs its own removable GRUB path and does not yet
    ship a signed boot chain. Refusing this combination is safer than letting
    the installer report success for a system firmware will not execute.
    """
    try:
        efivars_dir = "/sys/firmware/efi/efivars"
        entry = next((name for name in os.listdir(efivars_dir)
                      if name.startswith("SecureBoot-") and
                      os.path.isfile(os.path.join(efivars_dir, name))), None)
        if not entry:
            return False
        data = open(os.path.join(efivars_dir, entry), "rb").read()
        return len(data) >= 5 and data[4] == 1
    except (OSError, StopIteration):
        return False


def list_disks():
    out = subprocess.run(
        ["lsblk", "-J", "-b", "-o", "NAME,SIZE,MODEL,VENDOR,TYPE,RM,TRAN,RO"],
        capture_output=True, text=True, check=True).stdout
    live = live_medium_disk()
    disks = []
    for d in json.loads(out).get("blockdevices", []):
        if d.get("type") != "disk" or d.get("ro") in (True, "1", 1):
            continue
        name = d["name"]
        if name.startswith(("loop", "ram", "zram", "sr", "fd", "nbd")):
            continue
        path = f"/dev/{name}"
        size = int(d.get("size") or 0)
        disks.append({
            "path": path,
            "size": size,
            "model": ((d.get("vendor") or "") + " " + (d.get("model") or "")).strip() or "Unknown",
            "removable": d.get("rm") in (True, "1", 1),
            "transport": d.get("tran") or "",
            "live_medium": path == live,
            "too_small": size < 8 * 1024 ** 3,
        })
    return disks


# ── Install ───────────────────────────────────────────────────────────────────

class Installer:
    def __init__(self, cfg):
        self.cfg = cfg
        self.disk = cfg["disk"]
        self.done_weight = 0.0
        self.mounted = []
        self.luks_open = False

    # -- progress -----------------------------------------------------------
    def step(self, sid, frac=0.0):
        label = dict(_STEPS)[sid]
        base = sum(w for k, w in _WEIGHTS.items()
                   if [s for s, _ in _STEPS].index(k) < [s for s, _ in _STEPS].index(sid))
        emit(event="step", id=sid, label=label,
             progress=min(0.999, base + _WEIGHTS[sid] * frac))

    # -- validation -----------------------------------------------------------
    def validate(self):
        c = self.cfg
        if os.geteuid() != 0:
            raise InstallError("must run as root")
        if platform.machine() not in GRUB_TARGETS:
            raise InstallError(f"unsupported architecture {platform.machine()}")
        if not os.path.exists(self.disk) or not os.path.exists(f"/sys/class/block/{os.path.basename(self.disk)}"):
            raise InstallError(f"{self.disk} is not a block device")
        if c.get("confirm") != self.disk:
            raise InstallError("disk confirmation does not match")
        if self.disk == live_medium_disk():
            raise InstallError("refusing to erase the disk Bastille is running from")
        if secure_boot_enabled():
            raise InstallError("Secure Boot is enabled; Bastille's current bootloader is not signed. "
                               "Disable Secure Boot before installing, or use a signed release build.")
        mounts = subprocess.run(["lsblk", "-no", "MOUNTPOINTS", self.disk],
                                capture_output=True, text=True).stdout.split()
        if [m for m in mounts if m and m != "[SWAP]"]:
            raise InstallError(f"{self.disk} has mounted partitions: {' '.join(mounts)}")
        if not USERNAME_RE.match(c.get("username", "")):
            raise InstallError("invalid username")
        if c["username"] in ("root", "user", "greeter"):
            raise InstallError("that username is reserved")
        if len(c.get("password", "")) < 1:
            raise InstallError("empty user password")
        if len(c.get("passphrase", "")) < 8:
            raise InstallError("disk passphrase must be at least 8 characters")
        if not HOSTNAME_RE.match(c.get("hostname", "bastille")):
            raise InstallError("invalid hostname")
        if c.get("level", "high") not in LEVELS:
            raise InstallError("invalid security level")
        if c.get("hardware_profile", "generic") not in HARDWARE_PROFILES:
            raise InstallError("invalid hardware profile")
        for name in c.get("profiles", []):
            if not PROFILE_RE.match(name):
                raise InstallError(f"invalid profile name: {name!r}")
        accts = c.get("accounts", {})
        for a, details in (accts.items() if isinstance(accts, dict) else [(x, {}) for x in accts]):
            if a not in ACCOUNT_TYPES:
                raise InstallError(f"unknown account type: {a!r}")
            if not isinstance(details, dict) or any(
                    not isinstance(v, str) or len(v) > 20000 for v in details.values()):
                raise InstallError(f"bad details for account {a!r}")
            for k, v in details.items():
                if k != "config" and ("\n" in v or "\r" in v):
                    raise InstallError(f"bad value for {a}.{k}")
        for a in c.get("apps", []):
            if a not in APP_DEPS or a in REQUIRED_APPS:
                raise InstallError(f"unknown app: {a!r}")
        for t, pin in c.get("pins", {}).items():
            if t not in PIN_TYPES:
                raise InstallError(f"unknown PIN type: {t!r}")
            if not (pin.isdigit() and len(pin) >= 4):
                raise InstallError("PINs must be at least 4 digits")
        size = int(open(f"/sys/class/block/{os.path.basename(self.disk)}/size").read()) * 512
        if size < 8 * 1024 ** 3:
            raise InstallError("disk is smaller than 8 GiB")
        self.squashfs = next((p for p in LIVE_SQUASHFS if os.path.exists(p)), None)
        if not self.squashfs:
            raise InstallError("could not find the live filesystem.squashfs "
                               "(install must be run from the live medium)")
        for tool in ("parted", "cryptsetup", "mkfs.ext4", "mkfs.fat", "unsquashfs",
                     "blkid", "partprobe"):
            if not shutil.which(tool):
                raise InstallError(f"required tool missing: {tool}")

    # -- steps --------------------------------------------------------------
    def partition(self):
        d = self.disk
        run("wipefs", "-a", "-f", d)
        run("parted", "-s", d, "mklabel", "gpt")
        run("parted", "-s", d, "mkpart", "ESP", "fat32", "1MiB", f"{1 + ESP_MIB}MiB")
        run("parted", "-s", d, "set", "1", "esp", "on")
        run("parted", "-s", d, "mkpart", "boot", "ext4",
            f"{1 + ESP_MIB}MiB", f"{1 + ESP_MIB + BOOT_MIB}MiB")
        run("parted", "-s", d, "mkpart", "bastille-luks", f"{1 + ESP_MIB + BOOT_MIB}MiB", "100%")
        run("partprobe", d, check=False)
        run("udevadm", "settle", check=False)
        self.esp, self.boot, self.luks = (part_path(d, n) for n in (1, 2, 3))
        for p in (self.esp, self.boot, self.luks):
            wait_for_node(p)

    def pbkdf_memory_kib(self):
        avail = 0
        for line in open("/proc/meminfo"):
            if line.startswith("MemAvailable:"):
                avail = int(line.split()[1])
        # argon2id memory must fit twice over (format + open); cap at 1 GiB.
        return max(65536, min(1048576, avail // 2))

    def format(self):
        run("mkfs.fat", "-F32", "-n", "BASTILLEEFI", self.esp)
        run("mkfs.ext4", "-F", "-q", "-L", "BASTILLE-BOOT", self.boot)
        mem = self.pbkdf_memory_kib()
        log(f"argon2id memory cost: {mem // 1024} MiB")
        pw = self.cfg["passphrase"]
        run("cryptsetup", "luksFormat", "--batch-mode", "--type=luks2",
            "--cipher=aes-xts-plain64", "--key-size=512", "--hash=sha512",
            "--pbkdf=argon2id", f"--pbkdf-memory={mem}", "--pbkdf-parallel=4",
            "--iter-time=3000", "--label=BASTILLE-ROOT", "--key-file=-", self.luks,
            input=pw)
        run("cryptsetup", "luksOpen", "--key-file=-", self.luks, MAPPER, input=pw)
        self.luks_open = True
        run("mkfs.ext4", "-F", "-q", "-L", "BASTILLE-ROOT", f"/dev/mapper/{MAPPER}")

    def mount_target(self):
        os.makedirs(TARGET, exist_ok=True)
        self.mount(f"/dev/mapper/{MAPPER}", TARGET)
        os.makedirs(f"{TARGET}/boot", exist_ok=True)
        self.mount(self.boot, f"{TARGET}/boot")
        os.makedirs(f"{TARGET}/boot/efi", exist_ok=True)
        self.mount(self.esp, f"{TARGET}/boot/efi")

    def mount(self, src, dst, *opts):
        run("mount", *opts, src, dst)
        self.mounted.append(dst)

    def copy_system(self):
        # unsquashfs only draws its progress bar on a terminal, so give it a pty.
        import pty
        master, slave = pty.openpty()
        proc = subprocess.Popen(["unsquashfs", "-f", "-d", TARGET, self.squashfs],
                                stdout=slave, stderr=slave, close_fds=True)
        os.close(slave)
        tail, buf, last = [], "", -1
        while True:
            try:
                chunk = os.read(master, 4096)
            except OSError:
                break
            if not chunk:
                break
            buf += chunk.decode("utf-8", "replace")
            parts = re.split(r"[\r\n]", buf)
            buf = parts.pop()
            for line in parts:
                m = re.search(r"(\d+)%\s*$", line.strip())
                if m:
                    pct = int(m.group(1))
                    if pct != last:
                        last = pct
                        self.step("copy", pct / 100)
                elif line.strip():
                    tail = (tail + [line.strip()])[-6:]
        os.close(master)
        if proc.wait() != 0:
            raise InstallError("unsquashfs failed while copying the system: "
                               + " | ".join(tail))
        for d in ("dev", "proc", "sys", "run", "tmp"):
            os.makedirs(f"{TARGET}/{d}", exist_ok=True)
        os.chmod(f"{TARGET}/tmp", 0o1777)

    def bind_mounts(self):
        for d in ("dev", "dev/pts", "proc", "sys", "run"):
            self.mount(f"/{d}", f"{TARGET}/{d}", "--bind")
        if os.path.isdir("/sys/firmware/efi/efivars"):
            self.mount("/sys/firmware/efi/efivars", f"{TARGET}/sys/firmware/efi/efivars", "--bind")

    def uuid(self, dev):
        return run("blkid", "-s", "UUID", "-o", "value", dev).stdout.strip()

    def configure(self):
        c = self.cfg
        t = TARGET
        hostname = c.get("hostname") or "bastille"
        root_uuid = self.uuid(f"/dev/mapper/{MAPPER}")
        luks_uuid = self.uuid(self.luks)
        boot_uuid = self.uuid(self.boot)
        esp_uuid = self.uuid(self.esp)
        self.luks_uuid = luks_uuid

        # Strip the live-only machinery: with live-boot in the initramfs the
        # installed system would try to boot as a live image.
        chroot("dpkg", "--purge", "--force-depends", "live-boot",
               "live-boot-initramfs-tools", "live-config", "live-config-sysvinit",
               check=False)
        shutil.rmtree(f"{t}/etc/live", ignore_errors=True)
        shutil.rmtree(f"{t}/lib/live", ignore_errors=True)

        # Keep the privacy-hardening proc mount line from the live fstab.
        extra = []
        try:
            extra = [l.rstrip("\n") for l in open(f"{t}/etc/fstab")
                     if l.startswith("proc ")]
        except OSError:
            pass
        with open(f"{t}/etc/fstab", "w") as f:
            f.write("# Bastille OS — generated by bastille-install\n")
            f.write(f"UUID={root_uuid} /         ext4 errors=remount-ro,noatime 0 1\n")
            f.write(f"UUID={boot_uuid} /boot     ext4 noatime,nodev,nosuid,noexec 0 2\n")
            f.write(f"UUID={esp_uuid}  /boot/efi vfat umask=0077,nodev,nosuid,noexec 0 2\n")
            f.write("tmpfs /tmp tmpfs defaults,nosuid,nodev,mode=1777 0 0\n")
            for l in extra:
                f.write(l + "\n")
        with open(f"{t}/etc/crypttab", "w") as f:
            f.write(f"cryptroot UUID={luks_uuid} none luks\n")

        # Initramfs: unlock the root volume, never try to resume from swap.
        os.makedirs(f"{t}/etc/cryptsetup-initramfs", exist_ok=True)
        with open(f"{t}/etc/cryptsetup-initramfs/conf-hook", "a") as f:
            f.write("CRYPTSETUP=y\n")
        os.makedirs(f"{t}/etc/initramfs-tools/conf.d", exist_ok=True)
        with open(f"{t}/etc/initramfs-tools/conf.d/resume", "w") as f:
            f.write("RESUME=none\n")

        with open(f"{t}/etc/hostname", "w") as f:
            f.write(hostname + "\n")

        # Keep the installer choice explicit and auditable. Hardware profiles
        # are intentionally data-only for now; device-specific tuning must be
        # added only after it has been tested on real machines.
        hardware = HARDWARE_PROFILES[c.get("hardware_profile", "generic")]
        with open(f"{t}/etc/bastille/hardware-profile", "w") as f:
            f.write(c.get("hardware_profile", "generic") + "\n")
        with open(f"{t}/etc/bastille/hardware-profile.json", "w") as f:
            json.dump({"id": c.get("hardware_profile", "generic"), **hardware}, f, indent=2)

        # User account.
        groups = [g for g in USER_GROUPS
                  if chroot("getent", "group", g, check=False).returncode == 0]
        args = ["useradd", "-m", "-s", "/bin/bash", "-c", c.get("fullname", "") or c["username"]]
        if groups:
            args += ["-G", ",".join(groups)]
        chroot(*args, c["username"])
        chroot("chpasswd", input=f"{c['username']}:{c['password']}\n")
        chroot("passwd", "-l", "root")

        # Live conveniences that must not ship on an installed system.
        for p in ("etc/ssh/sshd_config.d/bastille-live.conf",):
            try:
                os.unlink(f"{t}/{p}")
            except FileNotFoundError:
                pass
        chroot("rc-update", "del", "ssh", "default", check=False)
        chroot("rc-update", "del", "ssh", check=False)

        # greetd: log in with a password instead of the live auto-login.
        with open(f"{t}/etc/greetd/config.toml", "w") as f:
            f.write('[terminal]\nvt = 7\n\n[default_session]\n'
                    'command = "/usr/local/bin/bastille-greeter-session"\n'
                    'user = "greeter"\n')

        os.makedirs(f"{t}/etc/bastille", exist_ok=True)
        with open(f"{t}/etc/bastille/installed", "w") as f:
            f.write("1\n")

    def network_up(self):
        p = subprocess.run(["getent", "hosts", "deb.debian.org"],
                           capture_output=True, text=True, timeout=10)
        return p.returncode == 0

    def apps(self):
        """Keep the required + selected apps; install any extra dependencies still missing.

        The app launchers ship in the image. Unselected optional ones are removed from
        the target. Missing dependencies are fetched with apt, which needs a network:
        if there is none, the list is left for the bastille-apps-pending boot service.
        """
        t = TARGET
        chosen = [a for a in self.cfg.get("apps", []) if a in APP_DEPS]
        keep = set(REQUIRED_APPS) | set(chosen)
        for app in APP_DEPS:
            if app in keep:
                continue
            for p in (f"usr/local/bin/bastille-{app}",
                      f"usr/share/applications/bastille-{app}.desktop"):
                try:
                    os.unlink(f"{t}/{p}")
                except FileNotFoundError:
                    pass
        wanted = sorted({d for a in keep for d in APP_DEPS[a]})
        # Only what is not already in the image (the required apps' deps are baked in).
        deps = [d for d in wanted
                if subprocess.run(["chroot", TARGET, "dpkg", "-s", d],
                                  capture_output=True).returncode != 0]
        os.makedirs(f"{t}/etc/bastille", exist_ok=True)
        with open(f"{t}/etc/bastille/apps.selected", "w") as f:
            f.write("\n".join(list(REQUIRED_APPS) + chosen) + "\n")
        self.apps_pending = []
        if not deps:
            log("no extra packages needed")
            return
        try:
            online = self.network_up()
        except Exception:  # noqa: BLE001
            online = False
        if not online:
            log("no network: bastille-apps-pending installs them once the network is up")
            self.apps_pending = deps
        else:
            shutil.copy("/etc/resolv.conf", f"{t}/etc/resolv.conf") \
                if os.path.exists("/etc/resolv.conf") else None
            r1 = chroot("apt-get", "update", check=False)
            r2 = chroot("apt-get", "install", "-y", "--no-install-recommends", *deps,
                        check=False)
            if r1.returncode or r2.returncode:
                log("package install failed: bastille-apps-pending installs them once the network is up")
                self.apps_pending = deps
        if self.apps_pending:
            with open(f"{t}/etc/bastille/apps.pending", "w") as f:
                f.write("\n".join(self.apps_pending) + "\n")

    def accounts(self):
        """Apply the online accounts collected by the wizard.

        email / guerrilla  -> Mail app accounts.json (+ ~/.msmtprc for sending)
        signal / session   -> Messages app accounts.json (verification happens in the app)
        pgp                -> a real key pair generated for the user
        wireguard          -> /etc/wireguard/wg0.conf
        """
        import json as _json
        c, t = self.cfg, TARGET
        accts = c.get("accounts", {})
        if isinstance(accts, list):
            accts = {a: {} for a in accts}
        if not accts:
            return
        user = c["username"]
        home = f"{t}/home/{user}"
        mail_dir = f"{home}/.local/share/bastille-mail"
        msg_dir = f"{home}/.local/share/bastille-messages"

        mail = []
        if "email" in accts:
            e = accts["email"]
            imap_host, smtp_host = mail_servers(e["address"])
            mail.append({"type": "email", "address": e["address"],
                         "imap": {"host": imap_host, "port": 993},
                         "smtp": {"host": smtp_host, "port": 587}})
            rc = (f"defaults\nauth on\ntls on\ntls_trust_file /etc/ssl/certs/ca-certificates.crt\n\n"
                  f"account default\nhost {smtp_host}\nport 587\ntls_starttls on\n"
                  f"from {e['address']}\nuser {e['address']}\npassword {e['password']}\n")
            with open(f"{home}/.msmtprc", "w") as f:
                f.write(rc)
            os.chmod(f"{home}/.msmtprc", 0o600)
        if "guerrilla" in accts:
            mail.append({"type": "guerrilla", "name": accts["guerrilla"].get("name", "")})
        if mail:
            os.makedirs(mail_dir, exist_ok=True)
            with open(f"{mail_dir}/accounts.json", "w") as f:
                _json.dump(mail, f, indent=2)
            os.chmod(f"{mail_dir}/accounts.json", 0o600)

        msgs = {}
        if "signal" in accts:
            msgs["signal"] = {"number": accts["signal"]["number"].replace(" ", ""), "verified": False}
        if "session" in accts:
            sess = accts["session"]
            msgs["session"] = {"name": sess.get("name", ""),
                               "recovery_phrase": sess.get("recovery", ""),
                               "restore": bool(sess.get("recovery")), "created": False}
        if msgs:
            os.makedirs(msg_dir, exist_ok=True)
            with open(f"{msg_dir}/accounts.json", "w") as f:
                _json.dump(msgs, f, indent=2)
            os.chmod(f"{msg_dir}/accounts.json", 0o600)

        if "wireguard" in accts:
            os.makedirs(f"{t}/etc/wireguard", mode=0o700, exist_ok=True)
            with open(f"{t}/etc/wireguard/wg0.conf", "w") as f:
                f.write(accts["wireguard"]["config"].rstrip() + "\n")
            os.chmod(f"{t}/etc/wireguard/wg0.conf", 0o600)
            log("WireGuard configuration installed")

        # Hand everything under the home to the user before running gpg as them.
        chroot("chown", "-R", f"{user}:{user}", f"/home/{user}/.local", check=False)
        if os.path.exists(f"{home}/.msmtprc"):
            chroot("chown", f"{user}:{user}", f"/home/{user}/.msmtprc", check=False)

        if "pgp" in accts:
            p = accts["pgp"]
            os.makedirs(f"{home}/.gnupg", mode=0o700, exist_ok=True)
            chroot("chown", f"{user}:{user}", f"/home/{user}/.gnupg", check=False)
            uid = f"{p['name']} <{p['email']}>"
            r = chroot("runuser", "-u", user, "--", "env", f"HOME=/home/{user}",
                       "gpg", "--batch", "--pinentry-mode", "loopback", "--passphrase-fd", "0",
                       "--quick-generate-key", uid, "default", "default", "2y",
                       input=p["passphrase"] + "\n", check=False)
            log("PGP key generated" if r.returncode == 0 else "PGP key generation failed")

    def personalise(self):
        """Security level, profiles, online-account intents and PINs."""
        import json as _json
        c, t = self.cfg, TARGET
        level = c.get("level", "high")
        with open(f"{t}/etc/bastille/profile", "w") as f:
            f.write(level)
        profiles = {
            "level": level,
            "main": {"owner": c["username"]},
            "decoy": "decoy",
            "extra": c.get("profiles", []),
            "fake_duress_target": c.get("fake_duress_target", "decoy"),
            # Containers (LUKS2 images) are created at first boot, when the
            # user can unlock them with their own PIN.
            "containers_created": False,
            "duress_policy": "cryptographic-key-destruction",
        }
        with open(f"{t}/etc/bastille/profiles.json", "w") as f:
            _json.dump(profiles, f, indent=2)
        os.chmod(f"{t}/etc/bastille/profiles.json", 0o600)
        # Online accounts need credentials: record the intent, the first-boot
        # setup (and the apps) finish them. Nothing is contacted from here.
        self.accounts()
        # Only leftovers the installer could not finish (apps needing a network).
        with open(f"{t}/etc/bastille/first-boot.json", "w") as f:
            _json.dump({"apps_pending": getattr(self, "apps_pending", [])}, f, indent=2)
        os.chmod(f"{t}/etc/bastille/first-boot.json", 0o600)
        # Everything the old first-boot wizard asked for is collected by the installer.
        open(f"{t}/etc/bastille/setup.done", "w").close()
        for ptype, pin in c.get("pins", {}).items():
            chroot("/usr/local/sbin/bastille-set-pins", f"--type={ptype}", "--pin-stdin",
                   input=pin + "\n")
            log(f"{ptype} PIN set")

    def build_initramfs(self):
        # initramfs-tools needs a usable /etc/mtab and the cryptsetup hooks.
        chroot("update-initramfs", "-c", "-k", "all")

    def bootloader(self):
        arch = GRUB_TARGETS[platform.machine()]
        with open(f"{TARGET}/etc/default/grub", "w") as f:
            f.write('GRUB_DISTRIBUTOR="Bastille"\n'
                    'GRUB_TIMEOUT=3\n'
                    'GRUB_DEFAULT=0\n'
                    'GRUB_CMDLINE_LINUX_DEFAULT=""\n'
                    'GRUB_CMDLINE_LINUX=""\n'
                    'GRUB_DISABLE_OS_PROBER=true\n'
                    '# Recovery entries remain enabled so a failed userspace boot has a supported rescue path.\n'
                    'GRUB_DISABLE_LINUX_UUID=true\n')
        chroot("grub-install", f"--target={arch}", "--efi-directory=/boot/efi",
               "--boot-directory=/boot", "--removable", "--no-nvram",
               "--bootloader-id=Bastille")
        chroot("grub-mkconfig", "-o", "/boot/grub/grub.cfg")
        cfg = open(f"{TARGET}/boot/grub/grub.cfg").read()
        if "linux" not in cfg or "/dev/mapper/cryptroot" not in cfg:
            raise InstallError("grub-mkconfig did not produce a bootable entry")

    def cleanup(self):
        run("sync", check=False)
        for dst in reversed(self.mounted):
            run("umount", "-l", dst, check=False)
        self.mounted = []
        if self.luks_open:
            run("cryptsetup", "luksClose", MAPPER, check=False)
            self.luks_open = False

    # -- driver -------------------------------------------------------------
    def install(self):
        try:
            self.step("check")
            self.validate()
            self.step("partition")
            self.partition()
            self.step("format")
            self.format()
            self.mount_target()
            self.step("copy")
            self.copy_system()
            self.bind_mounts()
            self.step("configure")
            self.configure()
            self.step("apps")
            self.apps()
            self.step("personalise")
            self.personalise()
            self.step("initramfs")
            self.build_initramfs()
            self.step("bootloader")
            self.bootloader()
            self.step("finish")
            self.cleanup()
            emit(event="step", id="finish", label="Done", progress=1.0)
            emit(event="done")
            return 0
        except InstallError as e:
            emit(event="error", msg=str(e))
            return 1
        except Exception as e:  # noqa: BLE001
            emit(event="error", msg=f"unexpected error: {e!r}")
            return 1
        finally:
            self.cleanup()

    def preflight(self):
        """Run every non-destructive install check and emit a useful result.

        The GUI can call this before presenting the final erase confirmation.
        Keeping it separate from ``install`` makes it impossible for a disk
        probe to fall through into partitioning as a side effect.
        """
        try:
            self.step("check")
            self.validate()
            emit(event="preflight", disk=self.disk, architecture=platform.machine(),
                 squashfs=self.squashfs)
            emit(event="done")
            return 0
        except InstallError as e:
            emit(event="error", msg=str(e))
            return 1
        except Exception as e:  # noqa: BLE001
            emit(event="error", msg=f"unexpected error: {e!r}")
            return 1


def main():
    if "--list-disks" in sys.argv:
        print(json.dumps(list_disks()))
        return 0
    if "--install" in sys.argv:
        try:
            cfg = json.loads(sys.stdin.readline())
        except Exception as e:
            emit(event="error", msg=f"bad config: {e}")
            return 2
        return Installer(cfg).install()
    if "--preflight" in sys.argv:
        try:
            cfg = json.loads(sys.stdin.readline())
        except Exception as e:
            emit(event="error", msg=f"bad config: {e}")
            return 2
        return Installer(cfg).preflight()
    print(__doc__)
    return 0


if __name__ == "__main__":
    sys.exit(main())
