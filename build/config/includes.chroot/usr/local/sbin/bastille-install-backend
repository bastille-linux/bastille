#!/usr/bin/env python3
"""bastille-install-backend — root-side installer for Bastille OS.

Installs the running live system to a disk with a LUKS2-encrypted root.
It has no GUI and speaks JSON lines on stdout so bastille-install (the GTK
wizard) or a shell can drive it.

    bastille-install-backend --list-disks
    bastille-install-backend --install        # JSON config on stdin

Install config (stdin, one JSON object — secrets never touch argv):
    {"disk": "/dev/sda", "confirm": "/dev/sda",
     "passphrase": "...", "username": "alice", "password": "...",
     "fullname": "Alice", "hostname": "bastille"}

Disk layout (GPT):
    p1  512 MiB  FAT32  EFI system partition
    p2    1 GiB  ext4   /boot       (unencrypted: GRUB cannot unlock argon2id)
    p3    rest   LUKS2  root (ext4) (argon2id)

Events (stdout, one JSON object per line):
    {"event": "step",  "id": ..., "label": ..., "progress": 0..1}
    {"event": "log",   "msg": ...}
    {"event": "done"}
    {"event": "error", "msg": ...}
"""

import json
import os
import platform
import re
import shutil
import subprocess
import sys

LIVE_SQUASHFS = ["/run/live/medium/live/filesystem.squashfs",
                 "/lib/live/mount/medium/live/filesystem.squashfs",
                 "/run/bastille/filesystem.squashfs"]
TARGET = "/mnt/bastille-target"
MAPPER = "cryptroot"   # must match /etc/crypttab so root=/dev/mapper/cryptroot works
ESP_MIB = 512
BOOT_MIB = 1024

GRUB_TARGETS = {"aarch64": "arm64-efi", "x86_64": "x86_64-efi"}
USER_GROUPS = ["video", "input", "audio", "render", "tty", "seat", "_seatd",
               "plugdev", "netdev", "cdrom", "floppy", "dialout"]

USERNAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,30}$")
HOSTNAME_RE = re.compile(r"^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$")

_STEPS = [
    ("check",     "Checking the target disk"),
    ("partition", "Partitioning"),
    ("format",    "Creating encrypted volume"),
    ("copy",      "Copying system files"),
    ("configure", "Configuring the installed system"),
    ("initramfs", "Building the boot image"),
    ("bootloader", "Installing the bootloader"),
    ("finish",    "Finishing up"),
]
# Rough weight of each step in the overall progress bar.
_WEIGHTS = {"check": 0.02, "partition": 0.05, "format": 0.08, "copy": 0.55,
            "configure": 0.07, "initramfs": 0.12, "bootloader": 0.08,
            "finish": 0.03}


def emit(**ev):
    sys.stdout.write(json.dumps(ev) + "\n")
    sys.stdout.flush()


def log(msg):
    emit(event="log", msg=str(msg))


class InstallError(Exception):
    pass


def run(*args, input=None, check=True, env=None):
    """Run a command, stream its output to the log, raise InstallError on failure."""
    p = subprocess.run(list(args), input=input, text=True, env=env,
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    out = p.stdout.strip()
    if out:
        for line in out.splitlines()[-20:]:
            log(line)
    if check and p.returncode != 0:
        tail = " | ".join(out.splitlines()[-4:]) if out else "no output"
        raise InstallError(f"{args[0]} failed (exit {p.returncode}): {tail}")
    return p


def chroot(*args, **kw):
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive", LC_ALL="C.UTF-8")
    return run("chroot", TARGET, *args, env=env, **kw)


def part_path(disk, n):
    sep = "p" if disk[-1].isdigit() else ""
    return f"{disk}{sep}{n}"


def wait_for_node(path, timeout=10):
    """Block device nodes can lag (or never appear inside containers)."""
    import time
    deadline = time.time() + timeout
    while time.time() < deadline:
        if os.path.exists(path):
            return
        time.sleep(0.2)
    # Fall back to creating the node from sysfs.
    name = os.path.basename(path)
    try:
        major, minor = open(f"/sys/class/block/{name}/dev").read().strip().split(":")
        os.mknod(path, 0o660 | 0o060000, os.makedev(int(major), int(minor)))
    except Exception:
        raise InstallError(f"partition node {path} did not appear")


# ── Disk discovery ────────────────────────────────────────────────────────────

def live_medium_disk():
    """Whole-disk device the live system booted from, if any."""
    try:
        src = subprocess.run(["findmnt", "-n", "-o", "SOURCE", "/run/live/medium"],
                             capture_output=True, text=True).stdout.strip()
        if not src:
            return None
        parent = subprocess.run(["lsblk", "-no", "PKNAME", src],
                                capture_output=True, text=True).stdout.strip()
        return f"/dev/{parent}" if parent else src
    except Exception:
        return None


def list_disks():
    out = subprocess.run(
        ["lsblk", "-J", "-b", "-o", "NAME,SIZE,MODEL,VENDOR,TYPE,RM,TRAN,RO"],
        capture_output=True, text=True, check=True).stdout
    live = live_medium_disk()
    disks = []
    for d in json.loads(out).get("blockdevices", []):
        if d.get("type") != "disk" or d.get("ro") in (True, "1", 1):
            continue
        name = d["name"]
        if name.startswith(("loop", "ram", "zram", "sr", "fd", "nbd")):
            continue
        path = f"/dev/{name}"
        size = int(d.get("size") or 0)
        disks.append({
            "path": path,
            "size": size,
            "model": ((d.get("vendor") or "") + " " + (d.get("model") or "")).strip() or "Unknown",
            "removable": d.get("rm") in (True, "1", 1),
            "transport": d.get("tran") or "",
            "live_medium": path == live,
            "too_small": size < 8 * 1024 ** 3,
        })
    return disks


# ── Install ───────────────────────────────────────────────────────────────────

class Installer:
    def __init__(self, cfg):
        self.cfg = cfg
        self.disk = cfg["disk"]
        self.done_weight = 0.0
        self.mounted = []
        self.luks_open = False

    # -- progress -----------------------------------------------------------
    def step(self, sid, frac=0.0):
        label = dict(_STEPS)[sid]
        base = sum(w for k, w in _WEIGHTS.items()
                   if [s for s, _ in _STEPS].index(k) < [s for s, _ in _STEPS].index(sid))
        emit(event="step", id=sid, label=label,
             progress=min(0.999, base + _WEIGHTS[sid] * frac))

    # -- validation -----------------------------------------------------------
    def validate(self):
        c = self.cfg
        if os.geteuid() != 0:
            raise InstallError("must run as root")
        if platform.machine() not in GRUB_TARGETS:
            raise InstallError(f"unsupported architecture {platform.machine()}")
        if not os.path.exists(self.disk) or not os.path.exists(f"/sys/class/block/{os.path.basename(self.disk)}"):
            raise InstallError(f"{self.disk} is not a block device")
        if c.get("confirm") != self.disk:
            raise InstallError("disk confirmation does not match")
        if self.disk == live_medium_disk():
            raise InstallError("refusing to erase the disk Bastille is running from")
        mounts = subprocess.run(["lsblk", "-no", "MOUNTPOINTS", self.disk],
                                capture_output=True, text=True).stdout.split()
        if [m for m in mounts if m and m != "[SWAP]"]:
            raise InstallError(f"{self.disk} has mounted partitions: {' '.join(mounts)}")
        if not USERNAME_RE.match(c.get("username", "")):
            raise InstallError("invalid username")
        if c["username"] in ("root", "user", "greeter"):
            raise InstallError("that username is reserved")
        if len(c.get("password", "")) < 1:
            raise InstallError("empty user password")
        if len(c.get("passphrase", "")) < 8:
            raise InstallError("disk passphrase must be at least 8 characters")
        if not HOSTNAME_RE.match(c.get("hostname", "bastille")):
            raise InstallError("invalid hostname")
        size = int(open(f"/sys/class/block/{os.path.basename(self.disk)}/size").read()) * 512
        if size < 8 * 1024 ** 3:
            raise InstallError("disk is smaller than 8 GiB")
        self.squashfs = next((p for p in LIVE_SQUASHFS if os.path.exists(p)), None)
        if not self.squashfs:
            raise InstallError("could not find the live filesystem.squashfs "
                               "(install must be run from the live medium)")
        for tool in ("parted", "cryptsetup", "mkfs.ext4", "mkfs.fat", "unsquashfs",
                     "blkid", "partprobe"):
            if not shutil.which(tool):
                raise InstallError(f"required tool missing: {tool}")

    # -- steps --------------------------------------------------------------
    def partition(self):
        d = self.disk
        run("wipefs", "-a", "-f", d)
        run("parted", "-s", d, "mklabel", "gpt")
        run("parted", "-s", d, "mkpart", "ESP", "fat32", "1MiB", f"{1 + ESP_MIB}MiB")
        run("parted", "-s", d, "set", "1", "esp", "on")
        run("parted", "-s", d, "mkpart", "boot", "ext4",
            f"{1 + ESP_MIB}MiB", f"{1 + ESP_MIB + BOOT_MIB}MiB")
        run("parted", "-s", d, "mkpart", "bastille-luks", f"{1 + ESP_MIB + BOOT_MIB}MiB", "100%")
        run("partprobe", d, check=False)
        run("udevadm", "settle", check=False)
        self.esp, self.boot, self.luks = (part_path(d, n) for n in (1, 2, 3))
        for p in (self.esp, self.boot, self.luks):
            wait_for_node(p)

    def pbkdf_memory_kib(self):
        avail = 0
        for line in open("/proc/meminfo"):
            if line.startswith("MemAvailable:"):
                avail = int(line.split()[1])
        # argon2id memory must fit twice over (format + open); cap at 1 GiB.
        return max(65536, min(1048576, avail // 2))

    def format(self):
        run("mkfs.fat", "-F32", "-n", "BASTILLEEFI", self.esp)
        run("mkfs.ext4", "-F", "-q", "-L", "BASTILLE-BOOT", self.boot)
        mem = self.pbkdf_memory_kib()
        log(f"argon2id memory cost: {mem // 1024} MiB")
        pw = self.cfg["passphrase"]
        run("cryptsetup", "luksFormat", "--batch-mode", "--type=luks2",
            "--cipher=aes-xts-plain64", "--key-size=512", "--hash=sha512",
            "--pbkdf=argon2id", f"--pbkdf-memory={mem}", "--pbkdf-parallel=4",
            "--iter-time=3000", "--label=BASTILLE-ROOT", "--key-file=-", self.luks,
            input=pw)
        run("cryptsetup", "luksOpen", "--key-file=-", self.luks, MAPPER, input=pw)
        self.luks_open = True
        run("mkfs.ext4", "-F", "-q", "-L", "BASTILLE-ROOT", f"/dev/mapper/{MAPPER}")

    def mount_target(self):
        os.makedirs(TARGET, exist_ok=True)
        self.mount(f"/dev/mapper/{MAPPER}", TARGET)
        os.makedirs(f"{TARGET}/boot", exist_ok=True)
        self.mount(self.boot, f"{TARGET}/boot")
        os.makedirs(f"{TARGET}/boot/efi", exist_ok=True)
        self.mount(self.esp, f"{TARGET}/boot/efi")

    def mount(self, src, dst, *opts):
        run("mount", *opts, src, dst)
        self.mounted.append(dst)

    def copy_system(self):
        # unsquashfs only draws its progress bar on a terminal, so give it a pty.
        import pty
        master, slave = pty.openpty()
        proc = subprocess.Popen(["unsquashfs", "-f", "-d", TARGET, self.squashfs],
                                stdout=slave, stderr=slave, close_fds=True)
        os.close(slave)
        tail, buf, last = [], "", -1
        while True:
            try:
                chunk = os.read(master, 4096)
            except OSError:
                break
            if not chunk:
                break
            buf += chunk.decode("utf-8", "replace")
            parts = re.split(r"[\r\n]", buf)
            buf = parts.pop()
            for line in parts:
                m = re.search(r"(\d+)%\s*$", line.strip())
                if m:
                    pct = int(m.group(1))
                    if pct != last:
                        last = pct
                        self.step("copy", pct / 100)
                elif line.strip():
                    tail = (tail + [line.strip()])[-6:]
        os.close(master)
        if proc.wait() != 0:
            raise InstallError("unsquashfs failed while copying the system: "
                               + " | ".join(tail))
        for d in ("dev", "proc", "sys", "run", "tmp"):
            os.makedirs(f"{TARGET}/{d}", exist_ok=True)
        os.chmod(f"{TARGET}/tmp", 0o1777)

    def bind_mounts(self):
        for d in ("dev", "dev/pts", "proc", "sys", "run"):
            self.mount(f"/{d}", f"{TARGET}/{d}", "--bind")
        if os.path.isdir("/sys/firmware/efi/efivars"):
            self.mount("/sys/firmware/efi/efivars", f"{TARGET}/sys/firmware/efi/efivars", "--bind")

    def uuid(self, dev):
        return run("blkid", "-s", "UUID", "-o", "value", dev).stdout.strip()

    def configure(self):
        c = self.cfg
        t = TARGET
        hostname = c.get("hostname") or "bastille"
        root_uuid = self.uuid(f"/dev/mapper/{MAPPER}")
        luks_uuid = self.uuid(self.luks)
        boot_uuid = self.uuid(self.boot)
        esp_uuid = self.uuid(self.esp)
        self.luks_uuid = luks_uuid

        # Strip the live-only machinery: with live-boot in the initramfs the
        # installed system would try to boot as a live image.
        chroot("dpkg", "--purge", "--force-depends", "live-boot",
               "live-boot-initramfs-tools", "live-config", "live-config-sysvinit",
               check=False)
        shutil.rmtree(f"{t}/etc/live", ignore_errors=True)
        shutil.rmtree(f"{t}/lib/live", ignore_errors=True)

        # Keep the privacy-hardening proc mount line from the live fstab.
        extra = []
        try:
            extra = [l.rstrip("\n") for l in open(f"{t}/etc/fstab")
                     if l.startswith("proc ")]
        except OSError:
            pass
        with open(f"{t}/etc/fstab", "w") as f:
            f.write("# Bastille OS — generated by bastille-install\n")
            f.write(f"UUID={root_uuid} /         ext4 errors=remount-ro,noatime 0 1\n")
            f.write(f"UUID={boot_uuid} /boot     ext4 noatime,nodev,nosuid,noexec 0 2\n")
            f.write(f"UUID={esp_uuid}  /boot/efi vfat umask=0077,nodev,nosuid,noexec 0 2\n")
            f.write("tmpfs /tmp tmpfs defaults,nosuid,nodev,mode=1777 0 0\n")
            for l in extra:
                f.write(l + "\n")
        with open(f"{t}/etc/crypttab", "w") as f:
            f.write(f"cryptroot UUID={luks_uuid} none luks\n")

        # Initramfs: unlock the root volume, never try to resume from swap.
        os.makedirs(f"{t}/etc/cryptsetup-initramfs", exist_ok=True)
        with open(f"{t}/etc/cryptsetup-initramfs/conf-hook", "a") as f:
            f.write("CRYPTSETUP=y\n")
        os.makedirs(f"{t}/etc/initramfs-tools/conf.d", exist_ok=True)
        with open(f"{t}/etc/initramfs-tools/conf.d/resume", "w") as f:
            f.write("RESUME=none\n")

        with open(f"{t}/etc/hostname", "w") as f:
            f.write(hostname + "\n")

        # User account.
        groups = [g for g in USER_GROUPS
                  if chroot("getent", "group", g, check=False).returncode == 0]
        args = ["useradd", "-m", "-s", "/bin/bash", "-c", c.get("fullname", "") or c["username"]]
        if groups:
            args += ["-G", ",".join(groups)]
        chroot(*args, c["username"])
        chroot("chpasswd", input=f"{c['username']}:{c['password']}\n")
        chroot("passwd", "-l", "root")

        # Live conveniences that must not ship on an installed system.
        for p in ("etc/ssh/sshd_config.d/bastille-live.conf",):
            try:
                os.unlink(f"{t}/{p}")
            except FileNotFoundError:
                pass
        chroot("rc-update", "del", "ssh", "default", check=False)
        chroot("rc-update", "del", "ssh", check=False)

        # greetd: log in with a password instead of the live auto-login.
        with open(f"{t}/etc/greetd/config.toml", "w") as f:
            f.write('[terminal]\nvt = 7\n\n[default_session]\n'
                    'command = "agreety --cmd /usr/local/bin/bastille-session"\n'
                    'user = "greeter"\n')

        # First boot of the installed system runs the setup wizard again
        # (PINs, VPN, apps), so make sure a stale live flag doesn't suppress it.
        try:
            os.unlink(f"{t}/etc/bastille/setup.done")
        except FileNotFoundError:
            pass
        os.makedirs(f"{t}/etc/bastille", exist_ok=True)
        with open(f"{t}/etc/bastille/installed", "w") as f:
            f.write("1\n")

    def build_initramfs(self):
        # initramfs-tools needs a usable /etc/mtab and the cryptsetup hooks.
        chroot("update-initramfs", "-c", "-k", "all")

    def bootloader(self):
        arch = GRUB_TARGETS[platform.machine()]
        with open(f"{TARGET}/etc/default/grub", "w") as f:
            f.write('GRUB_DISTRIBUTOR="Bastille"\n'
                    'GRUB_TIMEOUT=3\n'
                    'GRUB_DEFAULT=0\n'
                    'GRUB_CMDLINE_LINUX_DEFAULT=""\n'
                    'GRUB_CMDLINE_LINUX=""\n'
                    'GRUB_DISABLE_OS_PROBER=true\n'
                    'GRUB_DISABLE_RECOVERY=true\n'
                    'GRUB_DISABLE_LINUX_UUID=true\n')
        chroot("grub-install", f"--target={arch}", "--efi-directory=/boot/efi",
               "--boot-directory=/boot", "--removable", "--no-nvram",
               "--bootloader-id=Bastille")
        chroot("grub-mkconfig", "-o", "/boot/grub/grub.cfg")
        cfg = open(f"{TARGET}/boot/grub/grub.cfg").read()
        if "linux" not in cfg or "/dev/mapper/cryptroot" not in cfg:
            raise InstallError("grub-mkconfig did not produce a bootable entry")

    def cleanup(self):
        run("sync", check=False)
        for dst in reversed(self.mounted):
            run("umount", "-l", dst, check=False)
        self.mounted = []
        if self.luks_open:
            run("cryptsetup", "luksClose", MAPPER, check=False)
            self.luks_open = False

    # -- driver -------------------------------------------------------------
    def install(self):
        try:
            self.step("check")
            self.validate()
            self.step("partition")
            self.partition()
            self.step("format")
            self.format()
            self.mount_target()
            self.step("copy")
            self.copy_system()
            self.bind_mounts()
            self.step("configure")
            self.configure()
            self.step("initramfs")
            self.build_initramfs()
            self.step("bootloader")
            self.bootloader()
            self.step("finish")
            self.cleanup()
            emit(event="step", id="finish", label="Done", progress=1.0)
            emit(event="done")
            return 0
        except InstallError as e:
            emit(event="error", msg=str(e))
            return 1
        except Exception as e:  # noqa: BLE001
            emit(event="error", msg=f"unexpected error: {e!r}")
            return 1
        finally:
            self.cleanup()


def main():
    if "--list-disks" in sys.argv:
        print(json.dumps(list_disks()))
        return 0
    if "--install" in sys.argv:
        try:
            cfg = json.loads(sys.stdin.readline())
        except Exception as e:
            emit(event="error", msg=f"bad config: {e}")
            return 2
        return Installer(cfg).install()
    print(__doc__)
    return 0


if __name__ == "__main__":
    sys.exit(main())
