# ── Pages ─────────────────────────────────────────────────────────────────────

class Page(Gtk.ScrolledWindow):
    title = ""
    sub = ""
    hint = ""
    primary = "Continue"

    def __init__(self, wiz):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.wiz = wiz
        self.st = wiz.state
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        self.box.set_margin_start(24)
        self.box.set_margin_end(24)
        self.box.set_margin_bottom(18)
        head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        head.add_css_class("panel-header")
        self.title_lbl = label(self.title, "panel-title")
        self.sub_lbl = label(self.sub, "panel-sub", wrap=True)
        head.append(self.title_lbl)
        head.append(self.sub_lbl)
        self.box.append(head)
        clamp = Adw.Clamp(maximum_size=980, tightening_threshold=760, child=self.box)
        clamp.set_margin_top(8)
        self.set_child(clamp)
        self.build()

    def add(self, w):
        self.box.append(w)
        return w

    def build(self):
        pass

    def on_show(self):
        pass

    def validate(self):
        return None

    def changed(self):
        self.wiz.refresh_nav()


