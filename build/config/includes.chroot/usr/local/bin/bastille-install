class DiskPage(Page):
    title = "Choose a disk"
    sub = "Bastille is installed to the whole disk. Everything on it will be erased."

    def build(self):
        self.list_card = Card()
        self.msg = label("", "row-desc", wrap=True)
        self.add(section("Available disks", self.list_card, self.msg))
        self.layout_title = label("", "section-title")
        self.layout_card = Card()
        lay = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        lay.append(self.layout_title)
        lay.append(self.layout_card)
        self.add(lay)
        self._group = None
        self._rows = []

    def rescan(self):
        prev = self.st.disk["path"] if self.st.disk else None
        self.list_card.clear()
        self._group, self._rows = None, []
        self._radio_by_path = {}
        self.st.disk = None
        try:
            disks = list_disks()
        except Exception as e:  # noqa: BLE001
            self.msg.set_text(f"Could not list disks: {e}")
            disks = []
        else:
            self.msg.set_text("" if disks else "No disks found. Attach a disk and press Rescan disks.")
        for d in disks:
            self.list_card.append(self._disk_row(d))
        if prev in self._radio_by_path:          # keep the choice when revisiting the step
            self._radio_by_path[prev].set_active(True)
        self._update_layout()
        self.changed()

    def _disk_row(self, d):
        kind = {"usb": "USB", "nvme": "NVMe", "sata": "SATA", "ata": "SATA"}.get(
            d["transport"], d["transport"].upper() or "Disk")
        desc = f"{d['path']} · {human_size(d['size'])} · {kind}" + (" · removable" if d["removable"] else "")
        radio = Gtk.CheckButton()
        radio.add_css_class("radio")
        radio.set_valign(Gtk.Align.CENTER)
        if self._group is None:
            self._group = radio
        else:
            radio.set_group(self._group)
        badges = []
        usable = True
        if d["live_medium"]:
            badges, usable = [badge("Bastille is running from this disk", "warn")], False
        elif d["too_small"]:
            badges, usable = [badge("Smaller than 8 GB", "warn")], False
        self._radio_by_path[d["path"]] = radio
        model = d["model"]
        if re.match(r"^0x[0-9a-fA-F]+$", model) or model == "Unknown":
            model = "Virtual disk" if d.get("transport") in ("", "virtio") else "Disk"
        row = Row(model, desc, "bl" if not d["removable"] else "am",
                  "ssd" if not d["removable"] else "stick",
                  badges + ([radio] if usable else [radio]), mono_desc=True)
        if not usable:
            row.add_css_class("dim")
            radio.set_sensitive(False)
        else:
            row.on_click(lambda r=radio: r.set_active(True))
            radio.connect("toggled", lambda r, d=d, row=row: self._toggled(r, d, row))
        self._rows.append(row)
        return row

    def _toggled(self, radio, d, row):
        if radio.get_active():
            self.st.disk = d
            for r in self._rows:
                r.remove_css_class("selected")
            row.add_css_class("selected")
            self._update_layout()
            self.changed()

    def _update_layout(self):
        self.layout_card.clear()
        d = self.st.disk
        if not d:
            self.layout_title.set_text("")
            return
        self.layout_title.set_text("HOW " + d["path"] + " WILL BE LAID OUT")
        grid = Gtk.Grid(column_homogeneous=True, column_spacing=2, hexpand=True)
        for text, col, span, css, ic in [("EFI", 0, 12, "part-efi", None), ("/boot", 12, 18, "part-boot", None),
                                         ("Encrypted root · LUKS2", 30, 70, "part-root", "lock")]:
            cell = Gtk.Box(spacing=6)
            cell.add_css_class("part")
            cell.add_css_class(css)
            if ic:
                cell.append(icon(ic, "#7ee08a", 12))
            cell.append(label(text, "mono"))
            grid.attach(cell, col, 0, span, 1)
        holder = Gtk.Box()
        holder.add_css_class("brow")
        holder.append(grid)
        self.layout_card.append(holder)
        self.layout_card.append(Row("EFI system partition", "FAT32", None, None, [badge("512 MB", "off")]))
        self.layout_card.append(Row("Boot", "Left unencrypted — GRUB can’t unlock Argon2id", None, None,
                                    [badge("1 GB", "off")]))
        self.layout_card.append(Row("Root", "LUKS2 container, ext4 inside", None, None,
                                    [badge("Rest of disk", "ok")]))

    def on_show(self):
        self.rescan()

    def validate(self):
        return None if self.st.disk else "Select a disk to continue."


class EncryptionPage(Page):
    title = "Disk encryption passphrase"
    sub = "You’ll type this every time the computer starts. Nobody can recover it for you."

    def build(self):
        self.p1, self.p2 = password_entry(), password_entry()
        self.match = badge("", "off")
        self.match.set_visible(False)
        segs = Gtk.Box(spacing=4, valign=Gtk.Align.CENTER)
        segs.set_size_request(120, -1)
        self.segs = []
        for _ in range(4):
            s = Gtk.Box(hexpand=True)
            s.add_css_class("seg")
            self.segs.append(s)
            segs.append(s)
        self.strength_badge = badge("—", "off")
        self.add(section("Passphrase", Card(
            Row("Passphrase", "At least 8 characters", "bl", "key", [self.p1]),
            Row("Confirm passphrase", "Type it again", "bl", "key", [self.match, self.p2]),
            Row("Strength", "Four or five unrelated words beat a short string of symbols",
                "gn", "shield", [segs, self.strength_badge]))))
        self.add(section("How your disk is protected", Card(
            Row("LUKS2 container", "cryptsetup luksFormat --type=luks2", "gn", "lock",
                [badge("Enabled", "ok")], mono_desc=True),
            Row("Cipher", "aes-xts-plain64 · 512-bit key · sha512", "bl", "chip",
                [badge("Strong", "ok")], mono_desc=True),
            Row("Argon2id key derivation", "Memory-hard · up to 1 GiB · 4 threads · about 3 s to unlock",
                "bl", "ram", [badge("Memory-hard", "ok")]))))
        self.add(Card(Row("There is no recovery",
                          "If you forget this passphrase, the data on the disk is gone for good.",
                          "am", "warn"), css="warn"))
        for e in (self.p1, self.p2):
            e.connect("changed", self._changed)

    def _changed(self, *_):
        a, b = self.p1.get_text(), self.p2.get_text()
        score, text = passphrase_strength(a)
        for i, s in enumerate(self.segs):
            for k in range(1, 5):
                s.remove_css_class(f"on-{k}")
            if i < score:
                s.add_css_class(f"on-{score}")
        set_badge(self.strength_badge, text or "—",
                  "ok" if score >= 3 else "warn" if score == 2 else "crit" if score == 1 else "off")
        self.match.set_visible(bool(b))
        if b:
            set_badge(self.match, "Match" if a == b else "No match", "ok" if a == b else "crit")
        self.st.passphrase = a
        self.changed()

    def validate(self):
        a, b = self.p1.get_text(), self.p2.get_text()
        if len(a) < 8:
            return "The passphrase must be at least 8 characters."
        if a != b:
            return "The two passphrases do not match."
        return None


class UserPage(Page):
    title = "Your account"
    sub = "This account signs in to the desktop. By design it has no administrator rights."

    def build(self):
        self.full = text_entry()
        self.user = text_entry()
        self.pw1, self.pw2 = password_entry(), password_entry()
        self.host = text_entry("bastille")
        self.match = badge("", "off")
        self.match.set_visible(False)
        self.add(section("User", Card(
            Row("Name", "Shown on the sign-in screen", None, None, [self.full]),
            Row("Username", "Lowercase letters, digits, - and _ · not root, user or greeter", None, None, [self.user]),
            Row("Password", "Used to sign in to the desktop", None, None, [self.pw1]),
            Row("Confirm password", None, None, None, [self.match, self.pw2]))))
        self.add(section("Computer", Card(
            Row("Computer name", "Bastille picks a random name at every start so the machine can’t be tracked by it",
                None, None, [self.host]))))
        self.add(section("What this account can do", Card(
            Row("Graphics, audio, input, network, removable media", "video · audio · input · netdev · plugdev",
                "gn", "check", [badge("Allowed", "ok")]),
            Row("Administrator (sudo)", "No admin group, no elevation", "rd", "lock", [badge("None", "off")]),
            Row("Root login", "Account locked on the installed system", "gn", "lock", [badge("Locked", "ok")]),
            Row("Remote login (SSH)", "Live-session SSH is removed after install", "gn", "shield",
                [badge("Removed", "ok")]))))
        self._auto = False
        self._touched = False
        self.full.connect("changed", self._full_changed)
        self.user.connect("changed", self._user_changed)
        for e in (self.pw1, self.pw2, self.host):
            e.connect("changed", self._any)

    def _full_changed(self, *_):
        if not self._touched:
            guess = re.sub(r"[^a-z0-9_-]", "", (self.full.get_text().split(" ") or [""])[0].lower())
            self._auto = True
            self.user.set_text(guess)
            self._auto = False
        self._any()

    def _user_changed(self, *_):
        if not self._auto:
            self._touched = True
        self._any()

    def _any(self, *_):
        a, b = self.pw1.get_text(), self.pw2.get_text()
        self.match.set_visible(bool(b))
        if b:
            set_badge(self.match, "Match" if a == b else "No match", "ok" if a == b else "crit")
        s = self.st
        s.full, s.username, s.password = self.full.get_text(), self.user.get_text(), a
        s.hostname = self.host.get_text() or "bastille"
        self.changed()

    def validate(self):
        u = self.user.get_text()
        if not re.match(r"^[a-z_][a-z0-9_-]{0,30}$", u):
            return "Username: lowercase letters, digits, '-' and '_' only, starting with a letter."
        if u in ("root", "user", "greeter"):
            return "That username is reserved."
        if not self.pw1.get_text():
            return "Choose a password."
        if self.pw1.get_text() != self.pw2.get_text():
            return "The two passwords do not match."
        if not re.match(r"^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$", self.host.get_text() or "x"):
            return "Computer name: letters, digits and '-' only."
        return None


class ProfilesPage(Page):
    title = "Profiles"
    sub = "Choose how locked down Bastille runs, and which profiles live on this computer."

    def build(self):
        self.level_card = Card()
        self.add(section("Security level", self.level_card))
        self._radios = {}
        group = None
        for key, name, desc, tone, ic in LEVELS:
            radio = Gtk.CheckButton()
            radio.add_css_class("radio")
            radio.set_valign(Gtk.Align.CENTER)
            if group is None:
                group = radio
            else:
                radio.set_group(group)
            suffix = ([badge("Recommended", "ok")] if key == "high" else []) + [radio]
            row = Row(name, desc, tone, ic, suffix)
            row.on_click(lambda r=radio: r.set_active(True))
            radio.connect("toggled", lambda r, k=key: self._pick(k) if r.get_active() else None)
            self._radios[key] = (radio, row)
            self.level_card.append(row)
        self.level_badge = badge(LEVEL_NAME[self.st.level], "run")
        self.main_row = Row("Main", "", None, "user", [self.level_badge])
        self.decoy_row = Row("Decoy", "Shown instead of Main when the fake duress PIN is entered. "
                             "Looks like a normal, clean desktop.", "am", "prof",
                             [badge("Fake duress target", "warn")])
        self.extra_card = Card(self.main_row, self.decoy_row)
        add_btn = button("Add", small=True)
        add_btn.connect("clicked", lambda *_: self._open_form())
        self.add_row = Row("Add a profile", "For example work, travel or research", None, "plus", [add_btn])
        self.extra_card.append(self.add_row)
        # Inline form, same look as the account forms (no popup dialog).
        self.name_entry = text_entry("", 320)
        self.name_entry.set_placeholder_text("work")
        self.name_entry.connect("activate", lambda *_: self._save_profile())
        line = Gtk.Box(spacing=12)
        lbl = label("Profile name", "row-label")
        lbl.set_size_request(170, -1)
        line.append(lbl)
        line.append(self.name_entry)
        self.form_err = label("", "form-error", wrap=True)
        self.form_err.set_visible(False)
        save, cancel = button("Add profile", "pri", small=True), button("Cancel", small=True)
        save.connect("clicked", lambda *_: self._save_profile())
        cancel.connect("clicked", lambda *_: self._close_form())
        btns = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        btns.append(cancel)
        btns.append(save)
        form = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        form.add_css_class("formbox")
        for w in (line, label("Letters, digits, - and _ only.", "row-desc"), self.form_err, btns):
            form.append(w)
        self.form_rev = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN, child=form)
        self.form_wrap = Gtk.Box()
        self.form_wrap.add_css_class("brow")
        self.form_wrap.add_css_class("formrow")
        self.form_rev.set_hexpand(True)
        self.form_wrap.append(self.form_rev)
        self.form_wrap.set_visible(False)
        self.extra_card.append(self.form_wrap)
        self.add(section("Profiles on this computer", self.extra_card))
        self._extra_rows = []
        self._pick(self.st.level)

    def _pick(self, key):
        self.st.level = key
        for k, (radio, row) in self._radios.items():
            if radio.get_active() != (k == key):
                radio.set_active(k == key)
            (row.add_css_class if k == key else row.remove_css_class)("selected")
        set_badge(self.level_badge, LEVEL_NAME[key], "run")
        self.wiz.hint_override = f"Security level: {LEVEL_NAME[key]} · you can change this later in Settings"
        self.changed()

    def on_show(self):
        s = self.st
        self.main_row.set_desc(f"{s.full or s.username} · {s.username} · your everyday desktop")
        self._pick(s.level)

    def _open_form(self):
        self.name_entry.set_text("")
        self.form_err.set_visible(False)
        self.form_wrap.set_visible(True)
        self.form_rev.set_reveal_child(True)
        self.name_entry.grab_focus()

    def _close_form(self):
        self.form_rev.set_reveal_child(False)
        self.form_wrap.set_visible(False)

    def _save_profile(self):
        name = self.name_entry.get_text().strip()
        if not re.match(r"^[a-zA-Z0-9_-]{1,32}$", name):
            self.form_err.set_text("Use letters, digits, '-' and '_' only (up to 32 characters).")
            self.form_err.set_visible(True)
        elif name.lower() in ("main", "decoy") or name in self.st.profiles:
            self.form_err.set_text("That profile name is already used.")
            self.form_err.set_visible(True)
        else:
            self.st.profiles.append(name)
            self._close_form()
            self._refresh_extra()

    def _refresh_extra(self):
        for r in self._extra_rows:
            self.extra_card.remove(r)
        self._extra_rows = []
        self.extra_card.remove(self.add_row)
        self.extra_card.remove(self.form_wrap)
        for name in self.st.profiles:
            rm = button("Remove", small=True)
            row = Row(name, "Its own encrypted home, keyring and browser profile", None, "prof", [rm])
            rm.connect("clicked", lambda _b, n=name: (self.st.profiles.remove(n), self._refresh_extra()))
            self.extra_card.append(row)
            self._extra_rows.append(row)
        self.extra_card.append(self.add_row)
        self.extra_card.append(self.form_wrap)


ACCOUNT_FIELDS = {
    # key: [(field, label, placeholder, secret)]
    "email": [("address", "Email address", "you@example.com", False),
              ("password", "Password", "", True)],
    "guerrilla": [("name", "Address name (optional)", "leave empty for a random one", False)],
    "pgp": [("name", "Full name", "", False),
            ("email", "Email address", "you@example.com", False),
            ("passphrase", "Key passphrase", "", True),
            ("passphrase2", "Confirm passphrase", "", True)],
    "signal": [("number", "Phone number", "+370 600 00000", False)],
    "session": [("name", "Display name (optional)", "", False),
                ("recovery", "Recovery phrase (optional)", "13 words — leave empty to create a new identity", True)],
    "wireguard": [],
}
_EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
_HOST_RE = re.compile(r"^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$")


def validate_account(key, d):
    """Return an error message, or None when the details are usable."""
    if key == "email":
        if not _EMAIL_RE.match(d.get("address", "")):
            return "Enter a valid email address."
        if not d.get("password"):
            return "Enter the mailbox password."
    elif key == "guerrilla":
        if d.get("name") and not re.match(r"^[a-z0-9._-]{1,40}$", d["name"]):
            return "Use lowercase letters, digits, '.', '-' and '_' only."
    elif key == "pgp":
        if not d.get("name", "").strip():
            return "Enter the name for the key."
        if not _EMAIL_RE.match(d.get("email", "")):
            return "Enter a valid email address for the key."
        if len(d.get("passphrase", "")) < 8:
            return "The key passphrase must be at least 8 characters."
        if d.get("passphrase") != d.get("passphrase2"):
            return "The two key passphrases do not match."
    elif key == "signal":
        if not re.match(r"^\+\d{6,15}$", d.get("number", "").replace(" ", "")):
            return "Enter the number in international format, e.g. +37060000000."
    elif key == "session":
        if len(d.get("name", "")) > 40:
            return "The display name is too long."
        words = d.get("recovery", "").split()
        if words and len(words) != 13:
            return "A Session recovery phrase is 13 words."
    elif key == "wireguard":
        cfg = d.get("config", "")
        if "[Interface]" not in cfg or "PrivateKey" not in cfg or "[Peer]" not in cfg:
            return "That does not look like a WireGuard .conf (needs [Interface] and [Peer])."
        if len(cfg) > 20000:
            return "The configuration is too large."
    return None


class AccountsPage(Page):
    title = "Online accounts"

    def build(self):
        self._rows = {}
        for title, items in ACCOUNT_GROUPS:
            cards = []
            for key, name, desc, tone, ic in items:
                cards.append(self._make(key, name, desc, tone, ic))
            card = Card(*[c for pair in cards for c in pair])
            self.add(section(title, card))
        self.add(Card(Row("Saved on the encrypted disk",
                          "Details stay on this computer. Signal and Session verify or link inside their own "
                          "app after install, because that needs a code sent to you.", "bl", "info")))
        self._sync()

    def _make(self, key, name, desc, tone, ic):
        suffix = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
        row = Row(name, desc, tone, ic, [suffix])
        form = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        form.add_css_class("formbox")
        fields = {}
        for fname, flabel, ph, secret in ACCOUNT_FIELDS[key]:
            e = password_entry(320) if secret else text_entry("", 320)
            if not secret:
                e.set_placeholder_text(ph)
            line = Gtk.Box(spacing=12)
            lbl = label(flabel, "row-label")
            lbl.set_size_request(170, -1)
            line.append(lbl)
            line.append(e)
            form.append(line)
            fields[fname] = e
        tv = None
        if key == "wireguard":
            tv = Gtk.TextView(monospace=True, wrap_mode=Gtk.WrapMode.NONE, top_margin=8, bottom_margin=8,
                              left_margin=10, right_margin=10)
            tv.add_css_class("conf")
            sw = Gtk.ScrolledWindow(min_content_height=130, max_content_height=130)
            sw.set_child(tv)
            sw.add_css_class("confbox")
            load = button("Load .conf file…", small=True)
            load.set_halign(Gtk.Align.START)
            load.connect("clicked", lambda *_: self._load_conf(tv))
            form.append(label("Paste the configuration from your VPN provider, or load the file.", "row-desc"))
            form.append(sw)
            form.append(load)
        err = label("", "form-error", wrap=True)
        err.set_visible(False)
        form.append(err)
        save, cancel = button("Save", "pri", small=True), button("Cancel", small=True)
        btns = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        btns.append(cancel)
        btns.append(save)
        form.append(btns)
        rev = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN, child=form)
        wrap = Gtk.Box()
        wrap.add_css_class("brow")
        wrap.add_css_class("formrow")
        wrap.append(rev)
        rev.set_hexpand(True)
        wrap.set_visible(False)
        self._rows[key] = dict(row=row, suffix=suffix, rev=rev, wrap=wrap, fields=fields, tv=tv, err=err)
        save.connect("clicked", lambda *_: self._save(key))
        cancel.connect("clicked", lambda *_: self._close(key))
        return row, wrap

    def _load_conf(self, tv):
        dlg = Gtk.FileDialog()

        def done(d, res):
            try:
                f = d.open_finish(res)
                ok, data, _ = f.load_contents(None)
                if ok:
                    tv.get_buffer().set_text(data.decode("utf-8", "replace"))
            except Exception:  # noqa: BLE001
                pass
        dlg.open(self.wiz, None, done)

    def _collect(self, key):
        r = self._rows[key]
        d = {n: e.get_text().strip() if n not in ("password", "passphrase", "passphrase2", "recovery")
             else e.get_text() for n, e in r["fields"].items()}
        if r["tv"] is not None:
            buf = r["tv"].get_buffer()
            d["config"] = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        return d

    def _open(self, key):
        for k in self._rows:
            if k != key:
                self._close(k)
        r = self._rows[key]
        cur = self.st.accounts.get(key, {})
        for n, e in r["fields"].items():
            e.set_text(cur.get(n, ""))
        if r["tv"] is not None:
            r["tv"].get_buffer().set_text(cur.get("config", ""))
        r["err"].set_visible(False)
        r["wrap"].set_visible(True)
        r["rev"].set_reveal_child(True)

    def _close(self, key):
        r = self._rows[key]
        r["rev"].set_reveal_child(False)
        r["wrap"].set_visible(False)

    def _save(self, key):
        d = self._collect(key)
        err = validate_account(key, d)
        r = self._rows[key]
        if err:
            r["err"].set_text(err)
            r["err"].set_visible(True)
            return
        self.st.accounts[key] = d
        self._close(key)
        self._sync()

    def _sync(self):
        for key, r in self._rows.items():
            suffix = r["suffix"]
            while (c := suffix.get_first_child()) is not None:
                suffix.remove(c)
            if key in self.st.accounts:
                suffix.append(badge("Added", "ok"))
                edit, rm = button("Edit", small=True), button("Remove", small=True)
                edit.connect("clicked", lambda _b, k=key: self._open(k))
                rm.connect("clicked", lambda _b, k=key: (self.st.accounts.pop(k, None), self._sync()))
                suffix.append(edit)
                suffix.append(rm)
            else:
                add = button("Add", small=True)
                add.connect("clicked", lambda _b, k=key: self._open(k))
                suffix.append(add)
        n = len(self.st.accounts)
        self.sub_lbl.set_text("Optional. Add the accounts you’ll use and fill in their details here. "
                              "Everything is saved on the encrypted disk.")
        self.wiz.hint_override = f"{n} of {len(self._rows)} added · you can skip any of them"
        self.changed()

    def on_show(self):
        # Prefill the PGP details from the account name and email when empty.
        s = self.st
        r = self._rows["pgp"]["fields"]
        if not r["name"].get_text() and s.full:
            r["name"].set_text(s.full)
        em = self.st.accounts.get("email", {}).get("address", "")
        if not r["email"].get_text() and em:
            r["email"].set_text(em)
        self._sync()


class AppsPage(Page):
    title = "Choose your apps"

    def build(self):
        clear = button("Clear", small=True)
        sel = button("Select all", small=True)
        clear.connect("clicked", lambda *_: (self.st.apps.clear(), self._sync()))
        sel.connect("clicked", lambda *_: (self.st.apps.update(APP_ALL), self._sync()))
        self.add(section("Source", Card(Row(
            "github.com/bastille-linux/apps",
            "GTK4 native apps for Bastille OS · each installs to /usr/local/bin/bastille-<name>",
            "bl", "apps", [clear, sel], mono_desc=True))))
        self.add(section("Always installed", Card(*[
            Row(name, desc, tone, ic, [badge("Included", "ok")])
            for _, name, desc, tone, ic in REQUIRED_APPS])))
        self._btns = {}
        for title, items in APP_GROUPS:
            rows = []
            for key, name, desc, tone, ic in items:
                btn = button("Install", small=True)
                btn.connect("clicked", lambda _b, k=key: (self.st.apps.symmetric_difference_update({k}), self._sync()))
                self._btns[key] = btn
                rows.append(Row(name, desc, tone, ic, [btn]))
            self.add(section(title, Card(*rows)))
        self._sync()

    def _sync(self):
        for k, b in self._btns.items():
            on = k in self.st.apps
            b.set_label("✓ Installed" if on else "Install")
            (b.add_css_class if on else b.remove_css_class)("btn-ok")
        n = len(self.st.apps)
        self.sub_lbl.set_text(f"Only {REQUIRED_NAMES} will be installed. Pick any of the {len(APP_ALL)} optional apps below."
                              if n == 0 else
                              f"{n} optional app{'s' if n != 1 else ''} will be installed with {REQUIRED_NAMES}.")
        self.wiz.hint_override = f"{n} of {len(APP_ALL)} optional apps selected · change later in Settings → Installed Apps"
        self.changed()

    def on_show(self):
        self._sync()


class DuressPage(Page):
    title = "Duress PINs"
    sub = ("Optional. Special PINs you can enter at the login or lock screen when someone "
           "is forcing you to unlock.")
    hint = "Skip this and set PINs later in Settings → Security PINs"

    def build(self):
        self.add(Card(Row("They look like a normal unlock",
                          "The screen doesn’t freeze or show a warning. Whoever is watching sees a login succeed.",
                          "bl", "info")))
        self.entries, self.badges = {}, {}
        rows = []
        for key, name, desc, tone, ic in [
                ("duress", "Duress PIN", "Wipes keys from RAM, shuts down the VPN and powers off straight away", "rd", "lock"),
                ("fake-duress", "Fake duress PIN",
                 "Looks like a wipe: the screen goes black, then a clean-looking decoy desktop appears", "am", "prof"),
                ("dsm", "DSM check-in PIN", "Check-in code for Device Stress Mode", "pu", "pin")]:
            e = password_entry(200)
            b = badge("Not set", "off")
            e.connect("changed", lambda *_: self._changed())
            self.entries[key], self.badges[key] = e, b
            rows.append(Row(name, desc, tone, ic, [b, e]))
        self.add(section("PINs", Card(*rows)))
        self.target = Gtk.DropDown.new_from_strings(["Decoy", "Main"])
        self.target.add_css_class("inp")
        self.target.set_valign(Gtk.Align.CENTER)
        self.target.connect("notify::selected", lambda *_: self._changed())
        self.add(section("Fake duress", Card(Row("Switch to this profile", "Created on the Profiles step",
                                                 None, None, [self.target]))))
        self.len_badge, self.diff_badge = badge("", "off"), badge("", "off")
        self.add(section("Checks", Card(Row("At least 4 digits", None, None, None, [self.len_badge]),
                                        Row("Different from each other and from your login password", None, None,
                                            None, [self.diff_badge]))))
        self.add(section("Device Stress Mode (DSM)", Card(Row(
            "Permanent, cannot be undone",
            "DSM overwrites the UEFI firmware and crypto-erases the NVMe. Restoring the BIOS needs a hardware "
            "SPI programmer. Leave this off unless you know you need it.", "rd", "warn",
            [badge("Destructive", "crit")]), css="crit")))

    def on_show(self):
        self.target.set_model(Gtk.StringList.new(["Decoy"] + list(self.st.profiles) + ["Main"]))
        self._changed()

    def pins(self):
        return {k: e.get_text() for k, e in self.entries.items() if e.get_text()}

    def _problems(self):
        pins = self.pins()
        short = [k for k, p in pins.items() if not (p.isdigit() and len(p) >= 4)]
        vals = list(pins.values()) + ([self.st.password] if pins and self.st.password else [])
        return short, len(set(vals)) != len(vals)

    def _changed(self):
        pins = self.pins()
        for k, b in self.badges.items():
            set_badge(b, "Set" if k in pins else "Not set", "ok" if k in pins else "off")
        short, dup = self._problems()
        set_badge(self.len_badge, "OK" if not short else "Digits only, 4 or more", "ok" if not short else "crit")
        set_badge(self.diff_badge, "OK" if not dup else "Must all be different", "ok" if not dup else "crit")
        self.st.pins = pins
        item = self.target.get_selected_item()
        self.st.fake_target = item.get_string().lower() if item else "decoy"
        self.changed()

    def validate(self):
        short, dup = self._problems()
        if short:
            return "PINs must be 4 or more digits."
        if dup:
            return "Each PIN must be different from the others and from your login password."
        return None

    def skip(self):
        for e in self.entries.values():
            e.set_text("")


class ReviewPage(Page):
    title = "Ready to install"
    sub = "Check the plan. Pressing Install starts straight away and can’t be undone."
    primary = "Install"

    def build(self):
        self.plan = Card()
        self.add(section("Install plan", self.plan))
        self.switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.switch.connect("notify::active", lambda *_: self.changed())
        self.warn_row = Row("", "This can’t be undone.", "rd", "warn", [badge("Destructive", "crit")])
        self.confirm = Row("I understand that this disk will be erased", "Required to enable the Install button",
                           None, None, [self.switch])
        self.confirm.on_click(lambda: self.switch.set_active(not self.switch.get_active()))
        self.add(Card(self.warn_row, self.confirm))

    def on_show(self):
        s = self.st
        d = s.disk
        self.plan.clear()
        na, np_ = len(s.accounts), len(s.apps)
        pins = [PIN_LABEL[k] for k in ("duress", "fake-duress") if k in s.pins]
        rows = [
            ("Install to", f"{d['model']} · {d['path']} · {human_size(d['size'])}", []),
            ("Partitions", "512 MB EFI · 1 GB /boot · rest LUKS2 root", []),
            ("Encryption", "LUKS2 · aes-xts-plain64 · 512-bit · argon2id", [badge("Passphrase set", "ok")]),
            ("Account", f"{s.full or s.username} · {s.username} · no admin rights", []),
            ("Computer name", f"{s.hostname} · randomised at each start", []),
            ("Profiles", f"Main ({LEVEL_NAME[s.level]}) and Decoy" + "".join(f" and {p}" for p in s.profiles),
             [badge(f"{2 + len(s.profiles)} profiles", "ok")]),
            ("Online accounts",
             (" and ".join(ACCOUNT_NAME[a] for a in sorted(s.accounts)) + " · details saved on the encrypted disk")
             if na else "None · add them later in Settings",
             [badge(f"{na} account{'s' if na != 1 else ''}", "ok" if na else "off")]),
            ("Duress PINs", (" and ".join(pins) + " set" if pins else "None set")
             + (" · DSM on" if "dsm" in s.pins else " · DSM off"),
             [badge(f"{len(s.pins)} PIN{'s' if len(s.pins) != 1 else ''}", "warn" if s.pins else "off")]),
            ("Apps", REQUIRED_NAMES + "".join(f", {APP_NAME[a]}" for a in APP_ALL if a in s.apps)
             + (" from bastille-linux/apps" if np_ else ""),
             [badge(f"{np_ + len(REQUIRED_APPS)} apps", "ok")]),
        ]
        for t, desc, suffix in rows:
            self.plan.append(Row(t, desc, None, None, suffix))
        self.warn_row.title.set_text(f"All data on {d['path']} will be permanently destroyed")
        self.switch.set_active(False)

    def validate(self):
        return None if self.switch.get_active() else "Confirm that the disk may be erased."


class InstallingPage(Page):
    title = "Installing Bastille OS"
    sub = "This takes a few minutes. Don’t turn the computer off."

    def build(self):
        self.what = label("Starting…", "row-label")
        self.overall = label("0% overall", ("mono", "row-desc"))
        self.bar = Gtk.ProgressBar()
        self.bar.add_css_class("bar")
        top = Gtk.Box()
        top.append(self.what)
        top.append(Gtk.Box(hexpand=True))
        top.append(self.overall)
        holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        holder.add_css_class("brow")
        holder.append(top)
        holder.append(self.bar)
        self.add(section("Progress", Card(holder)))
        self.step_rows = {}
        rows = []
        for sid, name in STEPS:
            b = badge("Waiting", "off")
            row = Row(name, None, "", "dot", [b], muted=True)
            self.step_rows[sid] = (row, b)
            rows.append(row)
        self.add(section("Steps", Card(*rows)))
        self.log_view = Gtk.TextView(editable=False, monospace=True, cursor_visible=False,
                                     wrap_mode=Gtk.WrapMode.WORD_CHAR, left_margin=14, right_margin=14,
                                     top_margin=10, bottom_margin=10)
        self.log_view.add_css_class("row-desc")
        sw = Gtk.ScrolledWindow(min_content_height=110, max_content_height=160, propagate_natural_height=True)
        sw.set_child(self.log_view)
        self.log_sw = sw
        self.add(section("Details", Card(sw, css="log")))
        self.error = Card(Row("The installation failed", "", "rd", "warn", [badge("Error", "crit")]), css="crit")
        self.error.set_visible(False)
        self.add(self.error)
        self._current = None

    def reset(self):
        self._current = None
        self.error.set_visible(False)
        self.bar.set_fraction(0)
        self.overall.set_text("0% overall")
        self.log_view.get_buffer().set_text("")
        for row, b in self.step_rows.values():
            self._style(row, b, "wait")

    def log(self, msg):
        buf = self.log_view.get_buffer()
        buf.insert(buf.get_end_iter(), msg + "\n")
        adj = self.log_sw.get_vadjustment()
        GLib.idle_add(lambda: adj.set_value(adj.get_upper()))

    def _style(self, row, b, state):
        row.remove_css_class("selected")
        row.title.remove_css_class("muted")
        new = chip({"done": "gn", "run": "bl"}.get(state, ""),
                   {"done": "check", "run": "spin"}.get(state, "dot"))
        row.remove(row.chip)
        row.prepend(new)
        row.chip = new
        if state == "done":
            set_badge(b, "Done", "ok")
        elif state == "run":
            set_badge(b, "Running", "run")
            row.add_css_class("selected")
        else:
            set_badge(b, "Waiting", "off")
            row.title.add_css_class("muted")

    def set_step(self, sid, progress):
        order = [s for s, _ in STEPS]
        if sid in self.step_rows and sid != self._current:
            for s in order[:order.index(sid)]:
                self._style(*self.step_rows[s], "done")
            self._style(*self.step_rows[sid], "run")
            self._current = sid
            self.what.set_text(dict(STEPS)[sid])
            self.wiz.hint_override = f"Step {order.index(sid) + 1} of {len(order)}"
            self.wiz.refresh_nav()
        self.bar.set_fraction(progress)
        self.overall.set_text(f"{int(progress * 100)}% overall")
        if sid in order:
            base = sum(WEIGHTS[k] for k in order[:order.index(sid)])
            pct = int(max(0.0, min(1.0, (progress - base) / WEIGHTS[sid])) * 100)
            row, b = self.step_rows[sid]
            if sid == "copy":
                set_badge(b, f"{pct}%", "run")
                self.what.set_text(f"{dict(STEPS)[sid]} · {pct}%")

    def finish_ok(self):
        for row, b in self.step_rows.values():
            self._style(row, b, "done")
        self.bar.set_fraction(1.0)
        self.overall.set_text("100% overall")

    def fail(self, msg):
        self.error.get_first_child().desc.set_text(msg)
        self.error.set_visible(True)


class DonePage(Page):
    title = "Installation complete"
    sub = "Remove the USB stick, then restart."
    primary = "Restart now"

    def build(self):
        self.add(Card(Row("Bastille OS is installed",
                          "You’ll be asked for the disk passphrase every time the computer starts.",
                          "gn", "ok", [badge("Success", "ok")])))
        self.next_card = Card()
        self.add(section("What happens next", self.next_card))
        self.setup_card = Card()
        self.add(section("Set up for you", self.setup_card))

    def on_show(self):
        s = self.st
        self.next_card.clear()
        for t, d in [("1 · Unlock the disk", "Enter your passphrase at boot, before anything else loads"),
                     (f"2 · Sign in as {s.username}", "With the account password you just chose"),
                     ("3 · Your desktop is ready", "Apps, profiles, accounts and PINs are already set up — "
                      "change any of it later in Settings")]:
            self.next_card.append(Row(t, d))
        self.setup_card.clear()
        n_apps = len(s.apps) + len(REQUIRED_APPS)
        self.setup_card.append(Row(f"{n_apps} apps",
                                   REQUIRED_NAMES + "".join(f", {APP_NAME[a]}" for a in APP_ALL if a in s.apps)
                                   + " · add more any time in Settings → Installed Apps",
                                   "gn", "apps", [badge("Installed", "ok")]))
        self.setup_card.append(Row(f"{2 + len(s.profiles)} profiles",
                                   f"Main ({LEVEL_NAME[s.level]}) and Decoy"
                                   + "".join(f" and {p}" for p in s.profiles), "bl", "prof",
                                   [badge("Ready", "ok")]))
        if s.accounts:
            self.setup_card.append(Row(f"{len(s.accounts)} online account{'s' if len(s.accounts) != 1 else ''}",
                                       " and ".join(ACCOUNT_NAME[a] for a in sorted(s.accounts)),
                                       "am", "acct", [badge("Added", "ok")]))
        if s.pins:
            self.setup_card.append(Row("Duress PINs", " and ".join(PIN_LABEL[k] for k in s.pins if k != "dsm")
                                       + (" · DSM on" if "dsm" in s.pins else " · DSM off"),
                                       "rd", "pin", [badge("Set", "ok")]))


# ── Window ────────────────────────────────────────────────────────────────────

class InstallWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.add_css_class("bastille")
        self.set_title("Install Bastille OS")
        self.set_default_size(1280, 800)
        self.set_decorated(False)
        self.visited = {0}
        self.state = State()
        self.hint_override = None
        self.ready = False

        self.pages = [WelcomePage(self), DiskPage(self), EncryptionPage(self), UserPage(self),
                      ProfilesPage(self), AccountsPage(self), AppsPage(self), DuressPage(self),
                      ReviewPage(self), InstallingPage(self), DonePage(self)]
        (self.welcome, self.disk_page, self.enc_page, self.user_page, self.profiles_page,
         self.accounts_page, self.apps_page, self.duress_page, self.review_page,
         self.install_page, self.done_page) = self.pages
        self.idx = 0

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        body = Gtk.Box(vexpand=True)
        root.append(body)

        self.nav = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.nav.add_css_class("nav")
        self.nav.set_size_request(260, -1)
        body.append(self.nav)

        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
        self.stack = Gtk.Stack(vexpand=True, transition_type=Gtk.StackTransitionType.CROSSFADE,
                               transition_duration=120)
        for i, p in enumerate(self.pages):
            self.stack.add_named(p, str(i))
        main.append(self.stack)

        footer = Gtk.Box(spacing=8)
        footer.add_css_class("footer")
        footer.set_size_request(-1, 56)
        self.left_btn = button("Rescan disks")
        self.left_btn.connect("clicked", lambda *_: self.disk_page.rescan())
        self.hint = label("", "hint")
        self.hint.set_hexpand(True)
        self.skip_btn = button("Skip for now")
        self.skip_btn.connect("clicked", self._skip)
        self.back = button("Back")
        self.back.connect("clicked", self._go_back)
        self.next = button("Continue", "pri")
        self.next.connect("clicked", self._go_next)
        self.keep_btn = button("Keep using live system")
        self.keep_btn.connect("clicked", lambda *_: self.close())
        for w in (self.left_btn, self.hint, self.keep_btn, self.skip_btn, self.back, self.next):
            footer.append(w)
        main.append(footer)
        body.append(main)
        self.set_content(root)
        self.ready = True
        self._show(0)

    # navigation ---------------------------------------------------------
    def _page_ok(self, i):
        """True when page i has everything the install needs from it."""
        p = self.pages[i]
        if p in (self.install_page, self.done_page, self.welcome):
            return False
        return p.validate() is None

    def _required_pages(self):
        return [self.disk_page, self.enc_page, self.user_page]

    def _build_nav(self):
        while (c := self.nav.get_first_child()) is not None:
            self.nav.remove(c)
        busy = self.idx >= self.pages.index(self.install_page)
        i = 0
        for group, items in NAV:
            self.nav.append(label(group.upper(), "nav-label"))
            for text, ic in items:
                active = i == self.idx
                done = (i != self.idx and i in self.visited and self._page_ok(i)) or \
                       (i == 0 and self.idx > 0)
                locked = busy or i >= self.pages.index(self.install_page)
                row = Gtk.Button()
                row.add_css_class("nav-item")
                if active:
                    row.add_css_class("active")
                if locked and not active:
                    row.add_css_class("locked")
                box = Gtk.Box(spacing=8)
                color = "#3fb950" if done else "#2a78d6" if active else "#898781"
                box.append(icon("check" if done else ic, color, 16))
                box.append(label(text))
                row.set_child(box)
                row.set_halign(Gtk.Align.FILL)
                row.connect("clicked", lambda _b, n=i: self.goto(n))
                self.nav.append(row)
                i += 1

    def goto(self, n):
        """Jump to a step from the nav. Install and Done are not reachable this way."""
        inst = self.pages.index(self.install_page)
        if self.idx >= inst or n >= inst or n == self.idx:
            return
        if n == self.pages.index(self.review_page):
            for p in self._required_pages():
                if p.validate() is not None:
                    self._show(self.pages.index(p))
                    return
        self._show(n)

    def _show(self, i):
        self.idx = i
        self.visited.add(i)
        self.hint_override = None
        self.stack.set_visible_child_name(str(i))
        self._build_nav()
        self.pages[i].on_show()
        self.refresh_nav()

    def refresh_nav(self):
        if not self.ready:
            return
        page = self.pages[self.idx]
        busy = page is self.install_page
        done = page is self.done_page
        failed = busy and self.install_page.error.get_visible()
        err = None if busy or done else page.validate()
        self.left_btn.set_visible(page is self.disk_page)
        self.skip_btn.set_visible(page is self.duress_page)
        self.keep_btn.set_visible(done or page is self.welcome)
        self.keep_btn.set_label("Keep using live system" if done else "Try Bastille live instead")
        self.back.set_visible((not busy and not done and self.idx > 0) or failed)
        self.back.set_label("Start over" if failed else "Back")
        self.next.set_visible(not busy)
        self.next.set_label(page.primary)
        self.next.set_sensitive(err is None)
        for c in ("btn-pri", "btn-dng"):
            self.next.remove_css_class(c)
        self.next.add_css_class("btn-dng" if page is self.review_page else "btn-pri")
        self.hint.set_text(err or self.hint_override or page.hint)

    def _go_back(self, *_):
        if self.install_page.error.get_visible():
            self.install_page.reset()
            self._show(self.pages.index(self.review_page))
            return
        self._show(self.idx - 1)

    def _skip(self, *_):
        self.duress_page.skip()
        self._show(self.idx + 1)

    def _go_next(self, *_):
        page = self.pages[self.idx]
        if page is self.review_page:
            self._start_install()
        elif page is self.done_page:
            subprocess.Popen(["/sbin/reboot"] if os.geteuid() == 0 else ["pkexec", "/sbin/reboot"])
        else:
            self._show(self.idx + 1)

    # install ------------------------------------------------------------
    def _config(self):
        s = self.state
        return {
            "disk": s.disk["path"], "confirm": s.disk["path"], "passphrase": s.passphrase,
            "username": s.username, "fullname": s.full, "password": s.password,
            "hostname": s.hostname, "level": s.level, "profiles": list(s.profiles),
            "fake_duress_target": s.fake_target, "accounts": {k: dict(v) for k, v in s.accounts.items()},
            "apps": [a for a in APP_ALL if a in s.apps], "pins": dict(s.pins),
        }

    def _start_install(self):
        self.install_page.reset()
        self._show(self.pages.index(self.install_page))
        threading.Thread(target=self._run_backend, args=(self._config(),), daemon=True).start()

    def _run_backend(self, cfg):
        ip = self.install_page
        cmd = [BACKEND, "--install"]
        if os.geteuid() != 0:
            cmd = ["pkexec"] + cmd
        try:
            proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                    stderr=subprocess.STDOUT, text=True)
            proc.stdin.write(json.dumps(cfg) + "\n")
            proc.stdin.close()
        except Exception as e:  # noqa: BLE001
            GLib.idle_add(self._failed, f"Could not start the installer: {e}")
            return
        ok, failed = False, None
        for line in proc.stdout:
            line = line.rstrip("\n")
            try:
                ev = json.loads(line)
            except ValueError:
                GLib.idle_add(ip.log, line)
                continue
            kind = ev.get("event")
            if kind == "step":
                GLib.idle_add(ip.set_step, ev["id"], ev.get("progress", 0))
            elif kind == "log":
                GLib.idle_add(ip.log, ev["msg"])
            elif kind == "error":
                failed = ev["msg"]
            elif kind == "done":
                ok = True
        rc = proc.wait()
        if ok:
            GLib.idle_add(self._finished)
        else:
            GLib.idle_add(self._failed, failed or (
                "Authentication was cancelled." if rc in (126, 127)
                else f"The installer stopped unexpectedly (exit {rc})."))

    def _finished(self):
        self.install_page.finish_ok()
        self._show(self.pages.index(self.done_page))

    def _failed(self, msg):
        self.install_page.fail(msg)
        self.refresh_nav()


class InstallApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.connect("activate", self._activate)

    def _activate(self, app):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        css = Gtk.CssProvider()
        load_css(css, CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = InstallWindow(app)
        win.present()
        win.fullscreen()


if __name__ == "__main__":
    sys.exit(InstallApp().run(sys.argv))
