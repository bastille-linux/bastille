_tex_cache = {}


def icon(name, color="#c3c2b7", size=16):
    """Stroke icon (24px grid) rendered crisply at 4x and shown at `size`."""
    key = (name, color, size)
    tex = _tex_cache.get(key)
    if tex is None:
        px = size * 4
        svg = (f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" '
               f'width="{px}" height="{px}" fill="none" stroke="{color}" stroke-width="1.8" '
               f'stroke-linecap="round" stroke-linejoin="round"><path d="{ICONS[name]}"/></svg>')
        loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
        loader.write(svg.encode())
        loader.close()
        tex = Gdk.Texture.new_for_pixbuf(loader.get_pixbuf())
        _tex_cache[key] = tex
    img = Gtk.Image.new_from_paintable(tex)
    img.set_pixel_size(size)
    return img


# ── Small widget helpers ──────────────────────────────────────────────────────

def load_css(provider, css):
    if hasattr(provider, "load_from_string"):
        provider.load_from_string(css)
    else:
        provider.load_from_data(css.encode())


def label(text="", css=(), xalign=0.0, wrap=False):
    lbl = Gtk.Label(label=text, xalign=xalign, wrap=wrap)
    for c in ([css] if isinstance(css, str) else css):
        lbl.add_css_class(c)
    return lbl


def badge(text, kind="off"):
    b = label(text, ("badge", f"badge-{kind}"))
    b.set_valign(Gtk.Align.CENTER)
    return b


def set_badge(b, text, kind):
    for k in ("ok", "warn", "off", "crit", "run"):
        b.remove_css_class(f"badge-{k}")
    b.add_css_class(f"badge-{kind}")
    b.set_text(text)


def button(text, kind="", small=False):
    b = Gtk.Button(label=text)
    b.add_css_class("btn")
    if kind:
        b.add_css_class(f"btn-{kind}")
    if small:
        b.add_css_class("small")
    b.set_valign(Gtk.Align.CENTER)
    return b


def chip(tone, name):
    bg, fg = TONES.get(tone, TONES[""])
    box = Gtk.Box(halign=Gtk.Align.START, valign=Gtk.Align.CENTER, hexpand=False)
    box.add_css_class("chip")
    box.set_size_request(28, 28)
    prov = Gtk.CssProvider()
    load_css(prov, f"* {{ background: {bg}; }}")
    box.get_style_context().add_provider(prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    inner = icon(name, fg, 14)
    inner.set_halign(Gtk.Align.CENTER)
    inner.set_valign(Gtk.Align.CENTER)
    inner.set_margin_start(7)
    inner.set_margin_end(7)
    inner.set_margin_top(7)
    inner.set_margin_bottom(7)
    box.append(inner)
    return box


class Row(Gtk.Box):
    """One card row: [chip] label/description ........ suffix widgets."""

    def __init__(self, text, desc=None, tone=None, icon_name=None, suffix=(),
                 mono_desc=False, muted=False):
        super().__init__(spacing=12)
        self.add_css_class("brow")
        self.chip = None
        if icon_name:
            self.chip = chip(tone or "", icon_name)
            self.append(self.chip)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1, hexpand=True,
                      valign=Gtk.Align.CENTER)
        self.title = label(text, ("row-label", "muted") if muted else "row-label", wrap=True)
        col.append(self.title)
        self.desc = None
        if desc is not None:
            self.desc = label(desc, ("row-desc", "mono") if mono_desc else "row-desc", wrap=True)
            col.append(self.desc)
        self.append(col)
        for w in suffix:
            self.append(w)

    def set_desc(self, text):
        if self.desc:
            self.desc.set_text(text)

    def on_click(self, fn):
        g = Gtk.GestureClick()
        g.connect("released", lambda *_: fn())
        self.add_controller(g)
        self.set_cursor(Gdk.Cursor.new_from_name("pointer"))


class Card(Gtk.Box):
    def __init__(self, *rows, css=""):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.add_css_class("bcard")
        if css:
            self.add_css_class(css)
        for r in rows:
            self.append(r)

    def clear(self):
        while (c := self.get_first_child()) is not None:
            self.remove(c)


def section(title, *children):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    if title:
        t = label(title.upper(), "section-title")
        t.set_margin_start(2)
        box.append(t)
    for c in children:
        box.append(c)
    return box


def password_entry(width=260):
    e = Gtk.PasswordEntry(show_peek_icon=True)
    e.add_css_class("inp")
    e.set_size_request(width, -1)
    e.set_valign(Gtk.Align.CENTER)
    return e


def text_entry(text="", width=260):
    e = Gtk.Entry(text=text)
    e.add_css_class("inp")
    e.set_size_request(width, -1)
    e.set_valign(Gtk.Align.CENTER)
    return e


def human_size(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000


def list_disks():
    p = subprocess.run([BACKEND, "--list-disks"], capture_output=True, text=True)
    if p.returncode != 0:
        raise RuntimeError(p.stderr.strip() or "could not list disks")
    return json.loads(p.stdout)


def passphrase_strength(pw):
    """0..4 score, label. A nudge toward long passphrases; Argon2id does the rest."""
    if not pw:
        return 0, ""
    classes = sum(bool(re.search(p, pw)) for p in (r"[a-z]", r"[A-Z]", r"\d", r"[^\w\s]"))
    words = len([w for w in re.split(r"[\s\-_.]+", pw) if w])
    bits = len(pw) * 1.8 * (1 + 0.15 * (classes - 1))
    if words >= 4 and len(pw) >= 20:
        bits += 10
    if len(pw) < 8:
        return 1, "Too short"
    if bits < 35:
        return 1, "Weak"
    if bits < 55:
        return 2, "Fair"
    if bits < 75:
        return 3, "Good"
    return 4, "Strong"


