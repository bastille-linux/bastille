#!/bin/sh
# bastille-autostart — run once from the Sway config at login.
#
#   live session      -> the installer (fullscreen; its Welcome page offers
#                        "Try Bastille live instead", which just closes it)
#   installed system  -> nothing: accounts, PINs, profiles and apps were all
#                        set up by the installer
#
# Detected by what is mounted, not by a flag, so a stale file cannot change it.
if [ -d /run/live/medium ] || grep -q 'boot=live' /proc/cmdline 2>/dev/null; then
    exec bastille-install
fi
exit 0
