#!/usr/bin/env python3
"""bastille-browser — Tor Browser launcher with circuit & privacy panel."""
import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
import sys, os, subprocess, json, threading
from pathlib import Path
from gi.repository import Gtk, Adw, Gio, GLib

for _p in ("/usr/local/lib/bastille-shell",
           os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "bastille-shell")):
    if os.path.isdir(_p):
        sys.path.insert(0, _p)
import appstyle  # noqa: E402
import bdesign as bd  # noqa: E402
import icons  # noqa: E402

APP_ID = "org.bastilleos.Browser"
TOR_PATHS = [
    Path.home() / ".local/share/torbrowser/tbb/x86_64/tor-browser/Browser/start-tor-browser",
    Path("/usr/bin/tor-browser"),
    Path("/opt/tor-browser/start-tor-browser"),
    Path("/usr/bin/torbrowser-launcher"),
]
TOR_CTRL_PORT = 9051
TOR_COOKIE = Path("/var/run/tor/control.authcookie")
DATA_DIR = Path.home() / ".local/share/bastille-browser"
BOOKMARKS_FILE = DATA_DIR / "bookmarks.json"
NORMAL_BROWSERS = {
    "LibreWolf": "io.gitlab.librewolf-community",
    "Zen": "app.zen_browser.zen",
}

PRIVACY_CHECKS = [
    ("WebRTC disabled", True),
    ("Canvas fingerprint blocked", True),
    ("Font fingerprint blocked", True),
    ("JS sandboxed", True),
    ("3rd-party cookies blocked", True),
    ("Referrer stripped", True),
    ("DNS via Tor", True),
    ("Tracker blocked", True),
]


def find_tor_browser():
    for p in TOR_PATHS:
        if p.exists():
            return str(p)
    for name in ["torbrowser-launcher", "tor-browser"]:
        try:
            r = subprocess.run(["which", name], capture_output=True, text=True)
            if r.returncode == 0:
                return r.stdout.strip()
        except Exception:
            pass
    return None


def flatpak_installed(app_id):
    return subprocess.run(["flatpak", "info", "--user", app_id],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def launch_flatpak(app_id):
    subprocess.Popen(["flatpak", "run", app_id])


def get_tor_circuit():
    """Attempt to get Tor circuit info via control port."""
    try:
        import socket
        s = socket.socket()
        s.settimeout(3)
        s.connect(("127.0.0.1", TOR_CTRL_PORT))
        if TOR_COOKIE.exists():
            cookie = TOR_COOKIE.read_bytes()
            auth = b"AUTHENTICATE " + cookie.hex().encode() + b"\r\n"
        else:
            auth = b"AUTHENTICATE\r\n"
        s.sendall(auth)
        s.recv(256)
        s.sendall(b"GETINFO circuit-status\r\n")
        data = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            data += chunk
            if b"\r\n.\r\n" in data or b"250 OK" in data:
                break
        s.close()
        text = data.decode(errors="replace")
        circuits = []
        for line in text.splitlines():
            if "BUILT" in line and "$" in line:
                hops = [h.split("~")[-1] if "~" in h else h[:8] for h in line.split("$")[1:]]
                circuits.append(hops)
        return circuits[:1] if circuits else None
    except Exception:
        return None


def new_tor_circuit():
    """Ask the local Tor control port for a fresh circuit (SIGNAL NEWNYM)."""
    try:
        import socket
        s = socket.socket()
        s.settimeout(3)
        s.connect(("127.0.0.1", TOR_CTRL_PORT))
        if TOR_COOKIE.exists():
            auth = b"AUTHENTICATE " + TOR_COOKIE.read_bytes().hex().encode() + b"\r\n"
        else:
            auth = b"AUTHENTICATE\r\n"
        s.sendall(auth)
        s.recv(256)
        s.sendall(b"SIGNAL NEWNYM\r\n")
        s.close()
        return True
    except Exception:
        return False


NAV = [("Browsers", "globe"), ("Privacy", "shield"), ("Tor Circuit", "vpn"), ("Bookmarks", "folder")]


class BrowserWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.add_css_class("bapp")
        self.add_css_class("b2")
        self.set_title("Browser")
        self.set_default_size(960, 640)
        self._tor_proc = None
        self._bookmarks = self._load_bookmarks()
        try:    # double-click the top bar to maximise (fill the screen without fullscreen)
            bd.enable_maximize(self)
        except Exception:  # noqa: BLE001
            pass

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        handle = Gtk.WindowHandle()
        bar = Gtk.CenterBox()
        bar.add_css_class("b2-titlebar")
        lights = appstyle.traffic_lights()
        lights.set_margin_start(14)
        bar.set_start_widget(lights)
        title = Gtk.Label(label="Browser")
        title.add_css_class("b2-title")
        bar.set_center_widget(title)
        handle.set_child(bar)
        outer.append(handle)

        body = Gtk.Box(vexpand=True)
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        side.add_css_class("b2-nav")
        side.set_size_request(210, -1)
        side.append(Gtk.Label(label="PRIVATE BROWSING", xalign=0, css_classes=["b2-navlabel"]))
        self.nav = Gtk.ListBox()
        self.nav.add_css_class("navigation-sidebar")
        self.nav.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.nav.connect("row-selected", self._on_nav)
        for name, glyph in NAV:
            row = Gtk.ListBoxRow()
            row.add_css_class("b2-navitem")
            box = Gtk.Box(spacing=9)
            for m in ("start", "end"):
                getattr(box, f"set_margin_{m}")(10)
            box.set_margin_top(7)
            box.set_margin_bottom(7)
            box.append(icons.icon(glyph, "#898781", 15, 1.9))
            box.append(Gtk.Label(label=name, xalign=0, hexpand=True))
            row.set_child(box)
            row._name = name
            self.nav.append(row)
        side.append(self.nav)
        body.append(side)

        self.stack = Gtk.Stack()
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.add_named(self._page_browsers(), "Browsers")
        self.stack.add_named(self._page_privacy(), "Privacy")
        self.stack.add_named(self._page_circuit(), "Tor Circuit")
        self.stack.add_named(self._page_bookmarks(), "Bookmarks")
        body.append(self.stack)
        outer.append(body)
        self.set_content(outer)
        self.nav.select_row(self.nav.get_row_at_index(0))

    def _on_nav(self, _lb, row):
        if row is not None:
            self.stack.set_visible_child_name(row._name)
            if row._name == "Tor Circuit":
                self._refresh_circuit()

    # ── Browsers ──────────────────────────────────────────────────────────────
    def _page_browsers(self):
        page = bd.Page("Browsers", "Launch a browser. Tor Browser routes everything through Tor; the others do not.")
        tor_path = find_tor_browser()
        self._tor_btn = bd.button("Launch", self._launch_tor, "pri")
        self._tor_btn.set_sensitive(bool(tor_path))
        page.section("Tor", bd.Row("globe", "pu", "Tor Browser",
                                   tor_path or "Not found — install it with torbrowser-launcher",
                                   bd.badge("Tor", "run"), self._tor_btn))
        rows = []
        for name, app_id in NORMAL_BROWSERS.items():
            installed = flatpak_installed(app_id)
            btn = bd.button("Launch" if installed else "Install", kind="pri" if installed else "")
            btn.connect("clicked", lambda _b, n=name, a=app_id: self._normal_browser(n, a, _b))
            rows.append(bd.Row("globe", "bl", name, "Normal privacy browser — traffic does not use Tor",
                               bd.badge("Direct", "warn"), btn))
        page.section("Normal privacy browsers", *rows)
        self._status = bd.Row("info", "", "Status", "Ready")
        page.section("", self._status)
        return page

    def _say(self, text):
        self._status.set_desc(text)

    # ── Privacy ───────────────────────────────────────────────────────────────
    def _page_privacy(self):
        page = bd.Page("Privacy", "Protections applied by Tor Browser in this configuration")
        page.section("Tor Browser defaults", *[
            bd.Row("shield", "gn" if ok else "am", label, "", bd.badge("On" if ok else "Off", "ok" if ok else "warn"))
            for label, ok in PRIVACY_CHECKS])
        return page

    # ── Tor circuit ───────────────────────────────────────────────────────────
    def _page_circuit(self):
        page = bd.Page("Tor Circuit", "The three relays your Tor traffic currently passes through")
        self._circuit_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        page.add(self._circuit_box)
        return page

    def _refresh_circuit(self):
        bd.bg(get_tor_circuit, self._show_circuit)

    def _show_circuit(self, circuits):
        c = self._circuit_box.get_first_child()
        while c:
            self._circuit_box.remove(c)
            c = self._circuit_box.get_first_child()
        labels = ["Entry (guard)", "Middle", "Exit"]
        if circuits:
            rows = [bd.Row("vpn", "pu" if i == 2 else "bl", labels[i], hop) for i, hop in enumerate(circuits[0][:3])]
        else:
            rows = [bd.Row("info", "am", "No circuit information",
                           "Tor is not running, or its control port is not accessible")]
        self._circuit_box.append(bd.section("Current circuit", *rows))
        new = bd.button("New circuit", lambda: bd.bg(new_tor_circuit, lambda ok: (
            self._say("Requested a new Tor circuit" if ok else "Could not reach the Tor control port"),
            GLib.timeout_add(2000, lambda: (self._refresh_circuit(), False)[1]))))
        refresh = bd.button("Refresh", self._refresh_circuit)
        act = Gtk.Box(spacing=8)
        act.append(new)
        act.append(refresh)
        self._circuit_box.append(act)

    # ── Bookmarks ─────────────────────────────────────────────────────────────
    def _page_bookmarks(self):
        self._bm_page = bd.Page("Bookmarks", "Open a bookmark in Tor Browser")
        self._bm_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        self._bm_page.add(self._bm_box)
        self._refresh_bookmarks()
        return self._bm_page

    def _load_bookmarks(self):
        try:
            with open(BOOKMARKS_FILE) as f:
                return json.load(f)
        except Exception:
            return [
                {"title": "DuckDuckGo .onion", "url": "https://duckduckgogg42xjoc72x3sjasowoarfbgcmvfimaftt6twagswzczad.onion"},
                {"title": "EFF — Surveillance Self-Defense", "url": "https://ssd.eff.org"},
                {"title": "SecureDrop", "url": "https://secrdrop5wyphb5x.onion"},
            ]

    def _save_bookmarks(self):
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        with open(BOOKMARKS_FILE, "w") as f:
            json.dump(self._bookmarks, f, indent=2)

    def _refresh_bookmarks(self):
        c = self._bm_box.get_first_child()
        while c:
            self._bm_box.remove(c)
            c = self._bm_box.get_first_child()
        rows = []
        for bm in self._bookmarks:
            url = bm["url"]
            rm = bd.button("Remove", lambda b=bm: self._remove_bookmark(b), "dng")
            rows.append(bd.Row("globe", "bl", bm.get("title", url), url, rm, on_click=lambda u=url: self._open_url(u)))
        self._bm_box.append(bd.section("Saved", *(rows or [bd.Row("folder", "", "No bookmarks yet", "")])))
        self._bm_box.append(bd.button("Add bookmark", self._add_bookmark, "pri"))

    def _remove_bookmark(self, bm):
        if bm in self._bookmarks:
            self._bookmarks.remove(bm)
            self._save_bookmarks()
            self._refresh_bookmarks()

    def _add_bookmark(self, *_):
        dlg = Adw.MessageDialog.new(self)
        dlg.set_heading("Add bookmark")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_margin_start(16); box.set_margin_end(16)
        title_e = Gtk.Entry(); title_e.set_placeholder_text("Title")
        url_e = Gtk.Entry(); url_e.set_placeholder_text("URL or .onion address")
        box.append(title_e); box.append(url_e)
        dlg.set_extra_child(box)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("add", "Add")
        dlg.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)

        def resp(d, r):
            if r == "add" and url_e.get_text():
                self._bookmarks.append({"title": title_e.get_text() or url_e.get_text(), "url": url_e.get_text()})
                self._save_bookmarks()
                self._refresh_bookmarks()
        dlg.connect("response", resp)
        dlg.present()

    # ── launching ─────────────────────────────────────────────────────────────
    def _open_url(self, url: str):
        tor = find_tor_browser()
        subprocess.Popen([tor, url] if tor else ["xdg-open", url])

    def _launch_tor(self, *_):
        tor = find_tor_browser()
        if not tor:
            return
        try:
            self._tor_proc = subprocess.Popen([tor])
            self._say("Tor Browser launched")
        except Exception as e:
            self._say(f"Launch failed: {e}")

    def _normal_browser(self, name, app_id, button):
        def work():
            if not flatpak_installed(app_id):
                r = subprocess.run(["flatpak", "install", "--user", "-y", "flathub", app_id],
                                   capture_output=True, text=True, timeout=300)
                if r.returncode != 0:
                    return ("fail", r.stderr.strip()[-180:])
            launch_flatpak(app_id)
            return ("ok", "")

        def done(res):
            button.set_sensitive(True)
            if res and res[0] == "ok":
                button.set_label("Launch")
                self._say(f"{name} launched (normal privacy mode; Tor is not used)")
            else:
                button.set_label("Install")
                self._say(f"Could not install {name}: {res[1] if res else 'unknown error'}")
        button.set_sensitive(False)
        button.set_label("Installing…" if not flatpak_installed(app_id) else "Launching…")
        bd.bg(work, done)


class BrowserApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.connect("activate", self._on_activate)

    def _on_activate(self, app):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        appstyle.install()
        bd.install()
        (app.get_active_window() or BrowserWindow(app)).present()


if __name__ == "__main__":
    sys.exit(BrowserApp().run(sys.argv))
