for _p in ("/usr/local/lib/bastille-shell",
           os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "bastille-shell")):
    if os.path.isdir(_p):
        sys.path.insert(0, _p)
import appstyle  # noqa: E402
import icons     # noqa: E402

APP_ID = "org.bastilleos.Store"
FLATPAK = "/usr/local/bin/flatpak" if os.path.exists("/usr/local/bin/flatpak") else (shutil.which("flatpak") or "flatpak")
FLATHUB = "https://dl.flathub.org/repo/flathub.flatpakrepo"

