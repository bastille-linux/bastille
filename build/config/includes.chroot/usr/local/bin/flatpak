#!/bin/bash
# Bastille — Flatpak install gatekeeper.
# Allows only curated privacy-focused apps from Flathub.
# All other flatpak subcommands (run, list, update, remove) pass through unchanged.

ALLOWED=(
    "org.signal.Signal"
    "com.signal.Signal"
    "com.bitwarden.desktop"
    "fr.romainvigier.MetadataCleaner"
    "org.keepassxc.KeePassXC"
    "org.libreoffice.LibreOffice"
    "org.videolan.VLC"
    "org.gimp.GIMP"
    "org.inkscape.Inkscape"
    "org.audacityteam.Audacity"
    "org.mozilla.Thunderbird"
    "org.onionshare.OnionShare"
    "org.electrum.electrum"
    "com.github.micahflee.torbrowser-launcher"
    "org.gnome.Evince"
    "org.gnome.gedit"
    "org.gnome.Calculator"
    "org.gnome.clocks"
    "io.github.mimbrero.WhatsAppDesktop"
    "org.telegram.desktop"
    "md.obsidian.Obsidian"
    "net.mkiol.SpeechNote"
    "org.cryptomator.Cryptomator"
)

# "flatpak --user install ..." must be gated too, so look for the verb anywhere before a "--".
is_install=false
for arg in "$@"; do
    [[ "$arg" == "--" ]] && break
    [[ "$arg" == "install" ]] && is_install=true && break
done

if $is_install; then
    for arg in "$@"; do
        # Skip flags and the verb itself
        [[ "$arg" == -* || "$arg" == "install" ]] && continue
        # Check if it looks like an app ID (contains two dots)
        [[ "$arg" != *.*.* ]] && continue
        allowed=false
        for app in "${ALLOWED[@]}"; do
            [[ "$arg" == "$app" ]] && allowed=true && break
        done
        if ! $allowed; then
            echo "bastille: '$arg' is not in the approved app list." >&2
            echo "" >&2
            echo "Approved apps:" >&2
            printf '  %s\n' "${ALLOWED[@]}" >&2
            exit 1
        fi
    done
fi

exec /usr/bin/flatpak "$@"
