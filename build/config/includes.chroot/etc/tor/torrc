# THL — Tor opt-in configuration
# This config is used when the user enables Tor mode.
# Exit policies restrict to prevent abuse while allowing basic anonymity.

ExitPolicy reject *:*
SOCKSPort 127.0.0.1:9050
ControlPort 127.0.0.1:9051
CookieAuthFile /var/lib/tor/control.auth.cookie

# Logging
Log notice file /var/log/tor/notices.log

# Performance
MaxCircuitDirtiness 5 minutes

# Use the following when running as a relay is not desired
AvoidDiskWrites 1