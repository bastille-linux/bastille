# WireGuard VPN template for THL
# Copy this to /etc/wireguard/wg0.conf and fill in your credentials.
# The nftables kill-switch enforces that no traffic leaves outside wg0,
# so this config MUST be filled in before networking is available.
#
# DNS is deliberately omitted: NetworkManager manages the uplink and
# dnscrypt-proxy owns /etc/resolv.conf at 127.0.0.1:53. A wg-quick DNS= line
# would assume a different resolver manager and can bypass the single-resolver
# policy.

[Interface]
# Your WireGuard private key (generate with: wg genkey)
PrivateKey = REPLACE_WITH_YOUR_PRIVATE_KEY

# Your assigned VPN address
Address = 10.x.x.x/32

[Peer]
# Your VPN provider's public key
PublicKey = REPLACE_WITH_SERVER_PUBLIC_KEY

# VPN server endpoint
Endpoint = vpn.example.com:51820

# Route all traffic through the VPN
AllowedIPs = 0.0.0.0/0, ::/0

# Keep the tunnel alive through NAT
PersistentKeepalive = 25
