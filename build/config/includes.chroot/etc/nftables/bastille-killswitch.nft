#!/usr/sbin/nft -f
#
# THL VPN kill-switch + DNS enforcement
#
# Policy:
#   - All traffic is blocked by default.
#   - Only traffic through the WireGuard interface (wg0) is allowed out.
#   - Local applications use dnscrypt-proxy on 127.0.0.1:53. Only the
#     dnscrypt-proxy service identity may send encrypted resolver traffic.
#   - I2P SAM/proxy ports are allowed locally.
#   - Loopback is unrestricted.
#   - DHCP (port 67/68) is allowed on non-WireGuard interfaces so WireGuard
#     can establish its UDP tunnel in the first place.
#   - ICMPv6 neighbour discovery is allowed so IPv6 link-local works.
#
# Captive portals are intentionally not bypassed by this ruleset. Establish
# the VPN first, or use the documented manual recovery procedure after
# inspecting the active uplink with `ip -br link`.

flush ruleset

table inet thl-killswitch {

    # ------------------------------------------------------------------ #
    # Sets — update these as needed                                        #
    # ------------------------------------------------------------------ #

    # The endpoint port is configurable here because providers do not all use
    # WireGuard's conventional 51820. Any non-wg interface may carry only
    # DHCP and this explicitly configured handshake traffic.
    set wg_endpoint_ports {
        type inet_service
        elements = { 51820 }
    }

    # ------------------------------------------------------------------ #
    # INPUT                                                                #
    # ------------------------------------------------------------------ #
    chain input {
        type filter hook input priority filter; policy drop;

        # Allow established / related sessions
        ct state established,related accept

        # Loopback (including the local dnscrypt-proxy listener)
        iif lo accept

        # DHCP responses from uplink (needed to get an IP so WG can connect)
        iifname != "wg0" udp sport 67 udp dport 68 accept

        # WireGuard tunnel traffic coming back in
        iifname "wg0" accept

        # ICMPv6 neighbour discovery
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert,
                       nd-router-solicit, nd-router-advert } accept

        # Drop everything else silently
        drop
    }

    # ------------------------------------------------------------------ #
    # FORWARD                                                              #
    # ------------------------------------------------------------------ #
    chain forward {
        type filter hook forward priority filter; policy drop;
        # We are not a router; drop all forwarded traffic.
    }

    # ------------------------------------------------------------------ #
    # OUTPUT                                                               #
    # ------------------------------------------------------------------ #
    chain output {
        type filter hook output priority filter; policy drop;

        # Loopback always allowed
        oif lo accept

        # Allow established / related (replies to our own connections)
        ct state established,related accept

        # --- DNS enforcement ---
        # No process may send plain DNS off-host. Local DNS is handled by the
        # loopback accept above; dnscrypt-proxy's encrypted upstream traffic
        # is allowed only from its dedicated service account.
        oifname != "lo" udp dport 53 drop
        oifname != "lo" tcp dport 53 drop

        # --- WireGuard handshake / keepalive over uplink ---
        # WG needs UDP to reach the VPN endpoint before the tunnel is up.
        # This is the only direct-to-internet traffic we permit.
        oifname != "wg0" udp dport @wg_endpoint_ports accept
        # Allow DHCP out so we can get an IP address
        oifname != "wg0" udp sport 68 udp dport 67 accept

        # dnscrypt-proxy uses encrypted DNSCrypt/DoH upstreams (normally
        # UDP/TCP 443, sometimes TCP 853) through the VPN only.
        meta skuid _dnscrypt-proxy oifname "wg0" udp dport { 443, 853 } accept
        meta skuid _dnscrypt-proxy oifname "wg0" tcp dport { 443, 853 } accept

        # --- HTTPS-only enforcement ---
        # Block cleartext HTTP (port 80) and other unencrypted web ports
        # on the WireGuard interface. Browsers and apps must use HTTPS (443)
        # or TLS-wrapped equivalents. This prevents accidental cleartext
        # credential exposure even if an app tries HTTP fallback.
        oifname "wg0" tcp dport { 80, 8080, 8000, 3000 } drop

        # Allow HTTPS and common TLS ports through VPN
        oifname "wg0" tcp dport { 443, 8443, 993, 995, 465, 587 } accept

        # --- WireGuard / Tor choice ---
        # Traffic is normally routed through WireGuard.
        # When Tor is enabled (via thl-tor service), uncomment the lines below
        # to route through Tor instead.
        # oifname "wg0" accept  # WireGuard default
        oifname "wg0" accept

        # Allow connections to Tor SOCKS proxy (127.0.0.1:9050)
        oifname lo udp dport 9050 accept
        oifname lo tcp dport 9050 accept

        # ICMPv6 neighbour discovery outbound
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert,
                       nd-router-solicit, nd-router-advert } accept

        # Drop everything else (kill-switch engages here)
        drop
    }
}
