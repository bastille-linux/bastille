#!/sbin/openrc-run
# Bastille — nftables ruleset supervision for OpenRC.

description="Bastille nftables firewall"
NFT="/usr/sbin/nft"
RULES="/etc/nftables.conf"
KILLSWITCH="/etc/nftables/bastille-killswitch.nft"
WG_CONF="/etc/wireguard/wg0.conf"

depend() {
    after boot mountall.sh networkmanager
    before dnscrypt-proxy bastille-dns-lock wg-quick.wg0 bastille-network-guard
}

start() {
    rules="$RULES"
    # Kill switch only when a VPN is actually configured; otherwise every
    # packet would be dropped and the machine would have no network at all.
    [ -f "$WG_CONF" ] && rules="$KILLSWITCH"
    ebegin "Loading Bastille nftables rules ($rules)"
    "$NFT" -f "$rules"
    eend $?
}

stop() {
    ebegin "Removing Bastille nftables rules"
    "$NFT" delete table inet bastille-firewall 2>/dev/null || true
    "$NFT" delete table inet thl-killswitch 2>/dev/null || true
    "$NFT" delete table inet thl-offline 2>/dev/null || true
    eend 0
}

reload() {
    start
}
