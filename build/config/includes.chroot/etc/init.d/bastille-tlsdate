#!/sbin/openrc-run
# Bastille — HTTPS-based NTP using curl's authenticated Date header.
# Replaces default NTP which reveals IP to time servers.

description="THL NTP via tlsdate"

depend() {
    after network
    before time
}

start() {
    ebegin "Starting tlsdate NTP service"
    local header server_date

    # curl is part of the base image. Try independent HTTPS endpoints and
    # accept the first syntactically valid RFC 7231 Date header.
    for header in \
        https://www.cloudflare.com/ \
        https://www.google.com/ \
        https://deb.debian.org/; do
        server_date="$(curl -fsSI --max-time 12 "$header" 2>/dev/null | awk 'BEGIN{IGNORECASE=1} /^Date:/ {sub(/^[^:]*:[[:space:]]*/, ""); print; exit}')"
        if [ -n "$server_date" ] && date -u -d "$server_date" >/dev/null 2>&1; then
            date -u -s "$server_date" >/dev/null
            eend 0
            return 0
        fi
    done

    ewarn "No trusted HTTPS Date header was available; leaving the clock unchanged"
    eend 0
}

stop() {
    return 0
}
