#!/sbin/openrc-run
# OpenRC service: bastille-update-check
# Runs once at boot (after networking) to check for updates.
# Notifies the desktop user; does NOT auto-apply.

description="Bastille OS update availability check"

depend() {
    use networking
    after networking
    after network-online
}

start() {
    # Installed-to-disk systems use a different updater path; this service is
    # only for replacing the live medium's squashfs.
    [ -d /run/live/medium ] || return 0
    ebegin "Checking for Bastille OS updates"
    start-stop-daemon --start \
        --background \
        --exec /usr/local/sbin/bastille-update -- check \
        >> /var/log/bastille-update.log 2>&1
    eend $?
}

stop() {
    return 0
}
