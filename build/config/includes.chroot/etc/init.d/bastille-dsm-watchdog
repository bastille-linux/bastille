#!/sbin/openrc-run
# Bastille DSM (Device Stress Mode) watchdog

description="Bastille DSM attack watchdog"
pidfile="/run/bastille-dsm-watchdog.pid"
command="/usr/local/sbin/bastille-dsm-watchdog"
command_background=true

depend() {
    use networking
    after networking
    after elogind
}

start() {
    # Only run when DSM was explicitly enabled (bastille-set-pins creates the flag).
    if [ ! -f /etc/bastille/dsm.enabled ]; then
        einfo "DSM not enabled — skipping watchdog"
        return 0
    fi
    default_start
}
